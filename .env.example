# Public production origin used for canonical URLs, social metadata, robots, and sitemap.
# Set after the final domain is known, for example: https://your-domain.example
PUBLIC_SITE_URL=

# Public, non-secret Sanity identifiers used by the statically generated Astro site
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-08-31

# Sanity Studio reads these when run from /studio
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional public contact destinations. Leave blank rather than inventing links.
PUBLIC_CONTACT_EMAIL=
PUBLIC_LINKEDIN_URL=
PUBLIC_BOOKING_URL=
