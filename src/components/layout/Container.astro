---
interface Props { as?: 'div' | 'section' | 'nav' | 'header' | 'footer'; class?: string; }
const { as: Tag = 'div', class: className = '' } = Astro.props as Props;
---
<Tag class:list={['container', className]}><slot /></Tag>
<style>
  .container { width: 100%; max-width: var(--container); margin-inline: auto; padding-inline: 4rem; }
  @media (max-width: 1023px) { .container { padding-inline: 2rem; } }
  @media (max-width: 767px) { .container { padding-inline: 1.25rem; } }
</style>
