---
import Container from './Container.astro'; import Button from '../ui/Button.astro';
interface Props { variant?: 'default' | 'floating' }
const { variant = 'default' } = Astro.props;
const links=[['/work/','Work'],['/services/','Services'],['/about/','About'],['/insights/','Insights']]; const current=Astro.url.pathname;
---
<header class:list={['site-header', { 'site-header--floating': variant === 'floating' }]}>
  <Container>
    <div class="header-inner">
      <a class="wordmark" href="/" aria-label="SAMDIGITALS home">SAMDIGITALS<span>.</span></a>
      <nav class="desktop-nav" aria-label="Primary navigation">{links.map(([href,label])=><a href={href} aria-current={current.startsWith(href)?'page':undefined}>{label}</a>)}<Button href="/contact/">Start a Project</Button></nav>
      <button class="menu-trigger" type="button" aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded="false"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
    </div>
  </Container>
</header>
<dialog class="mobile-menu" id="mobile-navigation" aria-label="Mobile navigation">
  <div class="drawer">
    <div class="drawer-header"><span class="drawer-label">Navigation</span><button class="menu-close" type="button" aria-label="Close navigation"><span class="menu-icon menu-icon--close" aria-hidden="true"><i></i><i></i><i></i></span></button></div>
    <nav>{links.map(([href,label])=><a href={href} aria-current={current.startsWith(href)?'page':undefined}>{label}</a>)}<a class="mobile-cta" href="/contact/">Start a Project</a></nav>
  </div>
</dialog>
<script>
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-navigation');
  const closeButton = menu?.querySelector<HTMLButtonElement>('.menu-close');
  const setOpen = (open: boolean) => {
    if (!trigger || !menu) return;
    if (open && !menu.open) menu.showModal();
    if (!open && menu.open) menu.close();
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    trigger.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  };
  trigger?.addEventListener('click', () => setOpen(true));
  closeButton?.addEventListener('click', () => setOpen(false));
  menu?.addEventListener('cancel', (event) => { event.preventDefault(); setOpen(false); });
  menu?.addEventListener('click', (event) => { if (event.target === menu) setOpen(false); });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>
<style is:global>
  .site-header{position:absolute;inset:0 0 auto;z-index:20;height:78px;border-bottom:1px solid var(--dark-border);background:color-mix(in srgb,var(--navy-950) 82%,transparent);backdrop-filter:blur(16px)}.header-inner{height:78px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.wordmark{display:inline-flex;min-height:44px;align-items:center;font-size:.92rem;font-weight:750;letter-spacing:-.02em}.wordmark span{color:var(--blue-hover)}
  .desktop-nav{display:flex;align-items:center;gap:clamp(1.4rem,2.5vw,2.5rem)}.desktop-nav>a:not(.button){display:flex;min-width:44px;min-height:44px;align-items:center;justify-content:center;color:var(--text-secondary);font-size:.9rem}.desktop-nav>a:hover,.desktop-nav>a[aria-current=page]{color:var(--text)}
  .menu-trigger{display:none;width:48px;min-width:48px;height:48px;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(255,255,255,.07);color:var(--text);cursor:pointer;transition:background-color .2s,border-color .2s,transform .2s}.menu-trigger:hover{border-color:rgba(255,255,255,.42);background:rgba(255,255,255,.13)}.menu-icon{position:relative;display:grid;width:21px;height:16px;align-content:space-between}.menu-icon i{display:block;width:100%;height:1.5px;border-radius:999px;background:currentColor;transform-origin:center;transition:transform .28s ease,opacity .18s ease,width .28s ease}.menu-trigger.is-open .menu-icon i:first-child,.menu-icon--close i:first-child{transform:translateY(7.25px) rotate(45deg)}.menu-trigger.is-open .menu-icon i:nth-child(2),.menu-icon--close i:nth-child(2){width:0;opacity:0}.menu-trigger.is-open .menu-icon i:last-child,.menu-icon--close i:last-child{transform:translateY(-7.25px) rotate(-45deg)}
  .mobile-menu{width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:0;border:0;background:transparent;color:var(--text)}.mobile-menu::backdrop{background:rgba(3,9,18,.48);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}.drawer{position:absolute;top:clamp(5.25rem,12vw,6.25rem);right:clamp(.75rem,3vw,1.5rem);width:min(82vw,330px);max-height:calc(100dvh - 7rem);overflow-y:auto;padding:1rem 1.15rem 1.25rem;border:1px solid rgba(255,255,255,.2);border-radius:24px;background:linear-gradient(160deg,rgba(28,61,100,.96),rgba(8,27,52,.98));box-shadow:0 28px 80px rgba(2,10,26,.38),inset 0 1px 0 rgba(255,255,255,.14);transform-origin:top right;animation:menu-unfurl .38s cubic-bezier(.2,.8,.2,1) both;-webkit-backdrop-filter:blur(24px) saturate(1.2);backdrop-filter:blur(24px) saturate(1.2)}.drawer-header{min-height:52px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.12)}.drawer-label{color:var(--text-secondary);font-size:.68rem;font-weight:650;letter-spacing:.14em;text-transform:uppercase}.menu-close{width:44px;min-width:44px;height:44px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(255,255,255,.07);color:var(--text);cursor:pointer}.mobile-menu nav{display:grid;padding-top:.65rem}.mobile-menu nav a{min-height:52px;display:flex;align-items:center;border-bottom:1px solid rgba(255,255,255,.1);font-size:1rem}.mobile-menu nav a:hover,.mobile-menu nav a[aria-current=page]{color:#fff;background:rgba(255,255,255,.045)}.mobile-menu nav .mobile-cta{min-height:50px;justify-content:center;margin-top:1.1rem;padding-inline:1rem;border:1px solid rgba(255,255,255,.3);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-weight:650;text-align:center}.mobile-menu nav .mobile-cta:hover{background:rgba(255,176,0,.16)}@keyframes menu-unfurl{from{opacity:0;clip-path:inset(0 0 100% 0 round 24px);transform:translateY(-12px) scale(.94,.18)}to{opacity:1;clip-path:inset(0 round 24px);transform:none}}
  @media(max-width:900px){.desktop-nav{display:none}.menu-trigger{display:flex}}
</style>
<style is:global>body.menu-open{overflow:hidden}</style>
<style is:global>
  .site-header{border-bottom-color:rgba(255,255,255,.22);background:color-mix(in srgb,var(--royal-blue-dark) 84%,transparent)}
  .site-header.site-header--floating{top:clamp(.85rem,2vw,1.75rem);right:auto;left:50%;width:min(calc(100% - 40px),1216px);height:72px;transform:translateX(-50%);border:1px solid rgba(255,255,255,.28);border-radius:24px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(10,30,65,.34));box-shadow:0 18px 48px rgba(2,10,26,.2),inset 0 1px 0 rgba(255,255,255,.16);-webkit-backdrop-filter:blur(24px) saturate(1.3);backdrop-filter:blur(24px) saturate(1.3)}
  .site-header--floating{--button-primary-bg:rgba(255,255,255,.12);--button-primary-text:#fff;--button-primary-hover:rgba(244,181,64,.18)}.site-header--floating .desktop-nav .button{border-color:rgba(255,255,255,.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.12)}
  .site-header--floating .header-inner{height:70px}
  @media(max-width:767px){.site-header.site-header--floating{top:.75rem;width:calc(100% - 24px);height:64px;border-radius:19px}.site-header--floating .header-inner{height:62px}.site-header--floating .wordmark{font-size:.84rem}}
  @media(prefers-reduced-motion:reduce){.drawer{animation:none}}
</style>
