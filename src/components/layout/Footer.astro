---
import Container from './Container.astro'; const year=new Date().getFullYear();
---
<footer class="site-footer"><Container><div class="footer-grid"><div class="brand-block"><a class="wordmark" href="/">SAMDIGITALS<span>.</span></a><p>AI, automation, CRM, and web systems built around real business operations.</p></div><nav aria-label="Footer navigation"><div><p>Explore</p><a href="/work/">Work</a><a href="/services/">Services</a><a href="/about/">About</a><a href="/insights/">Insights</a></div><div><p>Connect</p><a href="/contact/">Start a Project</a></div></nav></div><div class="bottom"><span>© {year} SAMDIGITALS.</span><span>Built intentionally, not from a template.</span></div></Container></footer>
<style is:global>
  .site-footer{border-top:1px solid var(--dark-border);padding-block:5rem 2rem;background:var(--navy-950)}.site-footer .footer-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:3rem}.site-footer .brand-block{min-width:0}.site-footer .wordmark{display:inline-flex;min-height:44px;align-items:center;font-size:1.15rem;font-weight:750;letter-spacing:-.03em}.site-footer .wordmark span{color:var(--blue-hover)}.site-footer .brand-block p{max-width:27rem;margin:1.2rem 0 0;color:var(--text-light-secondary)}.site-footer nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem}.site-footer nav>div{display:grid;align-content:start}.site-footer nav p{margin:0 0 1rem;color:var(--text-muted);font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.site-footer nav a,.site-footer nav span{min-width:44px;min-height:44px;display:flex;align-items:center;color:var(--text-light-secondary);font-size:.88rem}.site-footer nav span{color:var(--text-muted)}.site-footer nav a:hover{color:var(--text-light)}.site-footer .bottom{display:flex;justify-content:space-between;gap:2rem;margin:5rem 0 0;padding-top:1.5rem;border-top:1px solid var(--dark-border);color:var(--text-muted);font-size:.72rem}
  @media(max-width:767px){.site-footer{padding-block:4rem 1.5rem}.site-footer .footer-grid{grid-template-columns:minmax(0,1fr);gap:3rem}.site-footer .brand-block,.site-footer .brand-block p{width:100%;max-width:none}.site-footer nav{grid-template-columns:minmax(0,1fr);gap:2rem}.site-footer nav a,.site-footer nav span{font-size:1rem}.site-footer .bottom{flex-direction:column;gap:.35rem;margin-top:3.5rem}}
</style>
