---
interface Props { type: 'telehealth' | 'mortgage' | 'attribution'; }
const { type } = Astro.props as Props;
---
<div class:list={['project-preview',`project-preview--${type}`]} aria-hidden="true">
  <div class="window-bar"><span></span><span></span><span></span><b>SYSTEM / {type.toUpperCase()}</b></div>
  {type === 'telehealth' && <div class="telehealth-ui"><aside><i></i><i></i><i></i><i></i></aside><div class="workspace"><div class="workspace-head"><span></span><em></em></div><div class="patient-flow"><div><small>01</small><strong>Intake</strong></div><b>→</b><div><small>02</small><strong>Clinical</strong></div><b>→</b><div><small>03</small><strong>Operations</strong></div></div><div class="data-row"><span></span><span></span><span></span></div></div></div>}
  {type === 'mortgage' && <div class="mortgage-ui"><div class="form-panel"><small>APPLICATION FLOW</small><span></span><span></span><div class="split"><i></i><i></i></div><span class="continue">Continue</span></div><div class="pipeline"><small>CONNECTED OPERATIONS</small><div><i></i><span>Website intake</span></div><div><i></i><span>Application system</span></div><div><i></i><span>Document workflow</span></div><div><i></i><span>Internal operations</span></div></div></div>}
  {type === 'attribution' && <div class="attribution-ui"><div class="chart"><small>ATTRIBUTION VIEW</small><svg viewBox="0 0 320 130"><path d="M4 112C48 108 48 72 92 79S142 99 176 59 238 78 316 17" fill="none" stroke="currentColor" stroke-width="3"/><path d="M4 112C48 108 48 72 92 79S142 99 176 59 238 78 316 17V130H4Z" fill="currentColor" opacity=".08"/></svg></div><div class="source-list"><span><i></i>Ads</span><span><i></i>Forms</span><span><i></i>CRM</span><span><i></i>Analytics</span></div></div>}
</div>

<style>
  .project-preview{min-height:320px;border:1px solid var(--dark-border);border-radius:var(--radius-md);background:var(--navy-950);overflow:hidden;color:var(--blue-hover)}.window-bar{height:42px;display:flex;align-items:center;gap:6px;padding:0 14px;border-bottom:1px solid var(--dark-border);background:var(--navy-900)}.window-bar span{width:6px;height:6px;border-radius:50%;background:color-mix(in srgb,var(--text-light-secondary) 38%,transparent)}.window-bar span:nth-child(2){background:var(--warm-accent)}.window-bar b{margin-left:auto;color:var(--text-muted);font-size:.6rem;letter-spacing:.12em}
  .telehealth-ui{height:278px;display:grid;grid-template-columns:72px 1fr}.telehealth-ui aside{display:grid;align-content:start;gap:16px;padding:24px 20px;border-right:1px solid var(--dark-border);background:var(--navy-900)}.telehealth-ui aside i{height:7px;border-radius:2px;background:color-mix(in srgb,var(--text-light-secondary) 18%,transparent)}.workspace{padding:26px}.workspace-head{display:flex;justify-content:space-between}.workspace-head span{width:38%;height:12px;background:color-mix(in srgb,var(--text-light-secondary) 22%,transparent)}.workspace-head em{width:60px;height:22px;border-radius:5px;background:var(--blue-soft);border:1px solid color-mix(in srgb,var(--blue) 55%,transparent)}.patient-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:12px;margin-top:55px}.patient-flow div{min-height:76px;padding:14px;border:1px solid var(--dark-border);border-radius:8px;background:var(--navy-800)}.patient-flow small{display:block;color:var(--text-muted);font-size:.6rem}.patient-flow strong{color:var(--text-light-secondary);font-size:.73rem;font-weight:500}.patient-flow b{color:var(--text-muted)}.data-row{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;margin-top:22px}.data-row span{height:8px;background:color-mix(in srgb,var(--text-light-secondary) 16%,transparent)}.data-row span:nth-child(3){background:var(--warm-accent)}
  .mortgage-ui{min-height:278px;display:grid;grid-template-columns:1.05fr .95fr;gap:24px;padding:28px}.form-panel,.pipeline{padding:20px;border:1px solid var(--dark-border);border-radius:10px;background:var(--navy-900)}.form-panel small,.pipeline small,.chart small{color:var(--text-muted);font-size:.58rem;letter-spacing:.12em}.form-panel>span{display:block;height:9px;margin-top:20px;background:color-mix(in srgb,var(--text-light-secondary) 16%,transparent)}.form-panel .split{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.form-panel i{height:28px;border:1px solid var(--dark-border);border-radius:5px}.form-panel button{width:70px;height:26px;margin-top:18px;border:0;border-radius:5px;background:var(--blue);color:white;font-size:.6rem}.pipeline div{display:flex;align-items:center;gap:10px;margin-top:18px;color:var(--text-light-secondary);font-size:.67rem}.pipeline i{width:8px;height:8px;border-radius:50%;border:1px solid var(--blue)}.pipeline div:nth-child(4) i{border-color:var(--warm-accent)}
  .attribution-ui{min-height:278px;display:grid;grid-template-columns:2fr 1fr;gap:20px;padding:28px}.chart,.source-list{padding:20px;border:1px solid var(--dark-border);border-radius:10px;background:var(--navy-900)}.chart svg{width:100%;margin-top:32px}.source-list{display:grid;align-content:center;gap:22px}.source-list span{display:flex;align-items:center;gap:10px;color:var(--text-light-secondary);font-size:.7rem}.source-list i{width:8px;height:8px;border-radius:2px;background:var(--blue-soft);border:1px solid var(--blue)}.source-list span:nth-child(2) i{background:color-mix(in srgb,var(--warm-accent) 24%,transparent);border-color:var(--warm-accent)}
  @media(max-width:600px){.project-preview{min-height:240px}.window-bar{height:36px}.telehealth-ui{height:220px;grid-template-columns:48px 1fr}.telehealth-ui aside{padding:18px 12px}.workspace{padding:18px}.patient-flow{gap:6px;margin-top:35px}.patient-flow div{min-height:62px;padding:8px}.patient-flow strong{font-size:.58rem}.data-row{margin-top:15px}.mortgage-ui,.attribution-ui{min-height:220px;gap:10px;padding:15px}.form-panel,.pipeline,.chart,.source-list{padding:12px}.pipeline div{margin-top:12px}.source-list{gap:14px}.chart svg{margin-top:25px}}
</style>
<style>.form-panel>.continue{display:flex;width:70px;height:26px;align-items:center;justify-content:center;margin-top:18px;border-radius:5px;background:var(--blue);color:white;font-size:.6rem}</style>
<style>
@media(max-width:319px){
  .window-bar b{min-width:0;font-size:.5rem;letter-spacing:.06em;overflow-wrap:anywhere}
  .telehealth-ui{grid-template-columns:minmax(0,1fr)}
  .telehealth-ui aside{display:none}
  .workspace{min-width:0;padding:12px}
  .patient-flow{grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;margin-top:28px}
  .patient-flow>b{display:none}
  .patient-flow div{min-width:0;padding:5px}
  .patient-flow strong{overflow-wrap:anywhere}
}
</style>
