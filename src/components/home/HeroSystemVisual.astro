<figure class="hero-system" aria-labelledby="hero-system-caption">
  <figcaption id="hero-system-caption">A connected business system moving from marketing through operations and data to revenue.</figcaption>
  <svg viewBox="0 0 520 610" role="img" aria-labelledby="hero-system-title hero-system-desc">
    <title id="hero-system-title">Connected business infrastructure</title>
    <desc id="hero-system-desc">Marketing connects to a website and CRM. The CRM branches to automation and data. Automation connects to AI, data connects to analytics, and both paths lead to revenue.</desc>
    <g class="paths" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M260 74V126"/><path d="M260 184V236"/><path d="M260 294L145 354"/><path d="M260 294L375 354"/><path d="M145 412V462"/><path d="M375 412V462"/><path d="M145 520L260 572"/><path d="M375 520L260 572"/>
    </g>
    <g class="nodes">
      <g transform="translate(180 24)"><rect width="160" height="50"/><text x="80" y="31">Marketing</text></g>
      <g transform="translate(180 134)"><rect width="160" height="50"/><text x="80" y="31">Website</text></g>
      <g class="active" transform="translate(180 244)"><rect width="160" height="50"/><circle cx="20" cy="25" r="4"/><text x="86" y="31">CRM</text></g>
      <g transform="translate(65 362)"><rect width="160" height="50"/><text x="80" y="31">Automation</text></g>
      <g transform="translate(295 362)"><rect width="160" height="50"/><text x="80" y="31">Data</text></g>
      <g transform="translate(65 470)"><rect width="160" height="50"/><text x="80" y="31">AI</text></g>
      <g transform="translate(295 470)"><rect width="160" height="50"/><text x="80" y="31">Analytics</text></g>
      <g class="revenue" transform="translate(180 558)"><rect width="160" height="50"/><text x="80" y="31">Revenue</text></g>
    </g>
  </svg>
  <div class="system-key"><span>Acquisition</span><span>Operations</span><span>Intelligence</span></div>
</figure>

<style>
  .hero-system{position:relative;margin:0;padding:clamp(1.25rem,3vw,2.25rem);border:1px solid var(--dark-border);border-radius:var(--radius-lg);background:linear-gradient(180deg,rgba(255,255,255,.025),transparent),var(--navy-900);overflow:hidden}
  .hero-system::before{position:absolute;inset:0;content:'';background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,black,transparent 90%);pointer-events:none}
  figcaption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  svg{position:relative;display:block;width:100%;height:auto;color:color-mix(in srgb,var(--text-light-secondary) 22%,transparent)}.nodes rect{fill:var(--navy-800);stroke:rgba(255,255,255,.12);rx:10}.nodes text{fill:var(--text-light-secondary);font-family:var(--font-sans);font-size:13px;text-anchor:middle}.nodes .active rect{fill:var(--blue-soft);stroke:var(--blue)}.nodes .active text,.nodes .revenue text{fill:var(--text-light)}.nodes .active circle{fill:var(--blue-hover)}.nodes .revenue rect{stroke:color-mix(in srgb,var(--blue) 40%,var(--dark-border))}
  .system-key{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;padding-top:1rem;border-top:1px solid var(--border);color:var(--text-muted);font-size:.67rem;letter-spacing:.08em;text-transform:uppercase}.system-key span{min-width:0;overflow-wrap:anywhere}.system-key span:nth-child(2){text-align:center}.system-key span:last-child{text-align:right}
  @media(max-width:767px){.hero-system{padding:1rem}.system-key{font-size:.6rem}svg{max-height:540px}}
</style>
