---
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<p class:list={['eyebrow',className]}><slot /></p>
<style>.eyebrow{margin:0 0 1.25rem;color:var(--eyebrow-color,var(--accent-bright));font-size:.75rem;font-weight:700;letter-spacing:.13em;line-height:1.3;text-transform:uppercase}</style>
