---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { absoluteSiteUrl, siteConfig } from '../config/site';
interface Props { title?:string; description?:string; image?:string; imageAlt?:string; type?:'website'|'article'; robots?:string; publishedAt?:string; modifiedAt?:string; structuredData?:Record<string,unknown>|Record<string,unknown>[] }
const {title=siteConfig.defaultTitle,description=siteConfig.defaultDescription,image=siteConfig.defaultSocialImage,imageAlt='SAMDIGITALS — AI Automation, CRM and Web Systems',type='website',robots,publishedAt,modifiedAt,structuredData}=Astro.props;
const canonical=absoluteSiteUrl(Astro.url.pathname);
const socialImage=image.startsWith('http')?image:(absoluteSiteUrl(image)||image);
const jsonLd=structuredData?JSON.stringify(structuredData).replace(/</g,'\\u003c'):undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="generator" content={Astro.generator}/>
  <meta name="description" content={description}/><meta name="author" content={siteConfig.author}/><meta name="theme-color" content={siteConfig.themeColor}/>
  {robots&&<meta name="robots" content={robots}/>} {canonical&&<link rel="canonical" href={canonical}/>}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
  <meta property="og:type" content={type}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:site_name" content={siteConfig.siteName}/>
  {canonical&&<meta property="og:url" content={canonical}/>} {socialImage&&<meta property="og:image" content={socialImage}/>} {socialImage&&<meta property="og:image:alt" content={imageAlt}/>}
  {type==='article'&&publishedAt&&<meta property="article:published_time" content={publishedAt}/>} {type==='article'&&modifiedAt&&<meta property="article:modified_time" content={modifiedAt}/>}
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>
  {socialImage&&<meta name="twitter:image" content={socialImage}/>} {socialImage&&<meta name="twitter:image:alt" content={imageAlt}/>}
  {jsonLd&&<script is:inline type="application/ld+json" set:html={jsonLd}/>}<title>{title}</title>
</head>
<body><a class="skip-link" href="#main-content">Skip to content</a><Header/><main id="main-content"><slot/></main><Footer/>
<script>
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduceMotion&&'IntersectionObserver'in window){const targets=document.querySelectorAll<HTMLElement>('.section-heading,.project-card,.service-panel,.services-list article,.principles li,.process li,.article-list>a,.insights-index li');const observer=new IntersectionObserver((entries)=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}}),{rootMargin:'0px 0px -8% 0px',threshold:.08});targets.forEach((target,index)=>{target.classList.add('reveal-item');target.style.transitionDelay=`${Math.min(index%4,3)*55}ms`;observer.observe(target)})}
</script></body>
</html>
