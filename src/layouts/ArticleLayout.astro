---
import BaseLayout from './BaseLayout.astro';import Container from '../components/layout/Container.astro';import Eyebrow from '../components/ui/Eyebrow.astro';import FinalCTA from '../components/ui/FinalCTA.astro';
interface Props{title:string;description:string;category:string;status:'draft'|'published';publishedAt?:Date;image?:string;structuredData?:Record<string,unknown>|Record<string,unknown>[]}
const {title,description,category,status,publishedAt,image,structuredData}=Astro.props;
---
<BaseLayout title={title} description={description} image={image} type="article" publishedAt={publishedAt?.toISOString()} structuredData={structuredData} robots={status==='draft'?'noindex, nofollow':undefined}>
<article><header class="article-hero"><Container><Eyebrow>{category}</Eyebrow><div class="status-row"><span>{status}</span>{publishedAt&&<time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>}</div><h1><slot name="title"/></h1><p><slot name="summary"/></p></Container></header>
<section class="article-content"><Container>{status==='draft'&&<aside class="draft-notice"><strong>Draft note</strong><p>This article structure is in development. It is intentionally not presented as a completed or published analysis.</p></aside>}<div class="prose"><slot/></div></Container></section>
<section class="related"><Container><Eyebrow>RELATED INSIGHTS</Eyebrow><div><slot name="related"/></div></Container></section></article>
<FinalCTA title="Have a system that needs a clearer architecture?" primaryLabel="Start a Project" secondaryLabel="All Insights" secondaryHref="/insights/"/>
</BaseLayout>
<style>
.article-hero{padding-block:clamp(8rem,14vw,12rem) clamp(5rem,9vw,8rem);border-bottom:1px solid var(--dark-border);background:var(--navy-950)}.status-row{display:flex;gap:1rem;margin-bottom:1.25rem;color:var(--text-muted);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.status-row span{color:var(--warm-accent)}h1{max-width:16ch;margin:0;font-size:clamp(2.7rem,7vw,6.2rem);font-weight:500;letter-spacing:-.055em;line-height:.93}.article-hero p{max-width:48rem;margin:1.5rem 0 0;color:var(--text-light-secondary);font-size:clamp(1rem,1.6vw,1.25rem)}.article-content{padding-block:var(--section-space);background:var(--light-100);color:var(--text-dark)}.article-content :global(.container){max-width:920px}.draft-notice{margin-bottom:3rem;padding:1.25rem;border-left:3px solid var(--warm-accent);background:var(--light-200)}.draft-notice strong{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}.draft-notice p{margin:.5rem 0 0;color:var(--text-dark-secondary)}.prose{max-width:760px}.prose :global(h2){margin:3rem 0 1rem;font-size:clamp(2rem,4vw,3rem);line-height:1}.prose :global(h3){margin:2.5rem 0 1rem;font-size:1.5rem}.prose :global(p),.prose :global(li){font-size:1.05rem;line-height:1.8}.prose :global(a){color:var(--blue);text-decoration:underline}.prose :global(blockquote){margin:2rem 0;padding-left:1.5rem;border-left:3px solid var(--blue)}.prose :global(code){padding:.15rem .35rem;border-radius:4px;background:var(--light-200)}.prose :global(pre){max-width:100%;overflow-x:auto;padding:1.25rem;border-radius:var(--radius-md);background:var(--navy-950);color:var(--text-light)}.prose :global(pre code){padding:0;background:transparent}.prose :global(img){max-width:100%;height:auto}.related{padding-block:clamp(4rem,8vw,7rem);background:var(--navy-900)}.related :global(a){display:flex;min-height:70px;align-items:center;border-bottom:1px solid var(--dark-border);color:var(--text-light-secondary)}
</style>
<style>
  .article-hero{background:linear-gradient(135deg,var(--royal-blue-dark),var(--royal-blue));border-bottom-color:rgba(255,255,255,.22)}
  .article-content{background:var(--pure-white)}.related{background:var(--soft-blue);color:var(--text-dark)}.related :global(a){border-color:var(--light-border);color:var(--text-dark-secondary)}
</style>
