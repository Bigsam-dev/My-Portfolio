---
import BaseLayout from '../layouts/BaseLayout.astro';import Container from '../components/layout/Container.astro';import Button from '../components/ui/Button.astro';import Eyebrow from '../components/ui/Eyebrow.astro';import PageHero from '../components/ui/PageHero.astro';import FinalCTA from '../components/ui/FinalCTA.astro';import RepresentativeProof from '../components/media/RepresentativeProof.astro';import {getSiteMedia} from '../lib/sanity/content';
const siteMedia=await getSiteMedia();
const services=[
{number:'01',title:'AI & Business Automation',positioning:'Replace repetitive work with intelligent workflows that move information, trigger actions, and support teams without creating unnecessary complexity.',capabilities:['AI Agents','Workflow Automation','Make','n8n','Zapier','API Automation','Data Extraction','Classification','Notifications','Internal Process Automation'],problems:['Repetitive admin work','Manual data transfer','Slow lead routing','Inconsistent follow-up','Disconnected applications','Repeated data entry','Information trapped in inboxes and forms'],note:'Automation should remove friction, not create a harder system to maintain.'},
{number:'02',title:'CRM & Revenue Systems',positioning:'Build a reliable operating layer for leads, customers, pipelines, follow-up, reporting, and sales activity.',capabilities:['CRM Architecture','Pipelines','Lead Routing','Lifecycle Stages','Follow-up Systems','Reporting','Attribution','Data Cleanup','Integrations','Forms','Dashboards'],problems:['Lost leads','Unclear ownership','Poor follow-up','Duplicate records','Unreliable pipeline reporting','CRM data that nobody trusts'],platforms:['Zoho','GoHighLevel','HubSpot','Clio','JobTread']},
{number:'03',title:'Web Apps & Internal Tools',positioning:'Build custom interfaces around workflows that off-the-shelf software cannot handle cleanly.',capabilities:['Dashboards','Customer Portals','Admin Portals','Internal Tools','SaaS MVPs','Calculators','Reporting Interfaces','API-connected Applications','Custom Workflow Interfaces'],problems:['Teams managing work in spreadsheets','Repetitive internal processes','Clients needing self-service','Systems that lack useful interfaces','Disconnected operational data']},
{number:'04',title:'Conversion-Focused Websites',positioning:'Build websites that become part of the business system rather than stopping at visual design.',capabilities:['Business Websites','Landing Pages','Lead Capture','Booking Flows','Forms','Shopify','Brevo','CRM-connected Websites','Conversion Paths','Application Flows','Analytics Integration'],problems:['Website leads going nowhere','Disconnected forms','Confusing customer journeys','Poor conversion flow','Website data not reaching operations']}
];
const process=[['01','Understand','Map the business, customer journey, workflow, and point of friction.'],['02','Architect','Define the data, logic, integrations, responsibilities, and boundaries.'],['03','Build','Implement the interfaces, configuration, automation, APIs, and infrastructure.'],['04','Test','Run the system against real workflows and failure conditions.'],['05','Optimize','Improve reliability and usability based on evidence from actual use.']];
---
<BaseLayout title="Services — AI Automation, CRM & Web Systems | SAMDIGITALS" description="AI automation, CRM and revenue systems, web applications, internal tools, and conversion-focused websites designed as connected business infrastructure.">
<PageHero eyebrow="SERVICES" title={'Build the system.\nNot another workaround.'} description="I design the infrastructure behind better operations, cleaner customer journeys, stronger follow-up, connected data, and less manual work." split><div slot="actions" class="hero-actions"><Button href="/contact/">Start a Project</Button><Button href="/work/" variant="secondary">View Selected Work</Button></div><div slot="visual" class="service-visual" role="img" aria-label="Service architecture connecting website, CRM, automation, data, and reporting"><span>Website</span><i>→</i><span>CRM</span><i>→</i><span>Automation</span><i>→</i><span>Data + Reporting</span></div></PageHero>
<section class="light-section intro"><Container><Eyebrow>SYSTEMS PARTNER</Eyebrow><div class="intro-grid"><h2>Different tools.<br/>One operating system.</h2><div><p>Most businesses already have software.</p><p>The real challenge is getting the website, CRM, automation, data, AI, and reporting layers to work as one connected system.</p><strong>That is where I focus.</strong></div></div></Container></section>
<section class="services-list" aria-label="Service areas"><Container>{services.map(service=><article><header><span>{service.number}</span><h2>{service.title}</h2><p>{service.positioning}</p></header><div class="service-details"><div><h3>Capabilities</h3><ul class="tags">{service.capabilities.map(item=><li>{item}</li>)}</ul>{service.platforms&&<><h3>Platforms may include</h3><ul class="platforms">{service.platforms.map(item=><li>{item}</li>)}</ul></>}</div><div><h3>Business problems</h3><ul class="problem-list">{service.problems.map(item=><li>{item}</li>)}</ul>{service.note&&<p class="service-note">{service.note}</p>}</div></div></article>)}</Container></section>
<section class="system-view"><Container><Eyebrow>CONNECTED SERVICE SYSTEM</Eyebrow><h2>Every layer should support what happens next.</h2><ol><li>Traffic</li><li>Website</li><li>CRM</li><li>Automation</li><li>Data</li><li><span>AI</span><span>Analytics</span></li><li>Revenue</li></ol></Container></section>
{siteMedia?.representativeProof?.length&&<section class="light-section representative-samples" aria-labelledby="representative-samples-title"><Container><Eyebrow>REPRESENTATIVE PROOF</Eyebrow><div class="representative-heading"><h2 id="representative-samples-title">Selected CRM / automation samples.</h2><p>General implementation evidence shown without attributing it to a named client project.</p></div><RepresentativeProof items={siteMedia.representativeProof} compact/></Container></section>}
<section class="light-section process"><Container><Eyebrow>HOW WE BUILD</Eyebrow><h2>Operational from the beginning.</h2><ol>{process.map(([number,title,copy])=><li><span>{number}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></Container></section>
<FinalCTA title="Have a process that should work better?" description="If your team is losing time between tools, manual steps, scattered data, or inconsistent follow-up, let's map the problem and design the right system." secondaryLabel="View Work"/>
</BaseLayout>
<style>
.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.service-visual{display:grid;grid-template-columns:minmax(0,1fr);gap:.6rem;padding:1.25rem;border:1px solid var(--dark-border);border-radius:var(--radius-lg);background:var(--navy-900)}.service-visual span{min-height:58px;display:grid;place-items:center;border:1px solid var(--dark-border);border-radius:9px;background:var(--navy-800);color:var(--text-light-secondary)}.service-visual i{color:var(--blue);text-align:center;font-style:normal;transform:rotate(90deg)}.light-section{padding-block:var(--section-space);background:var(--light-100);color:var(--text-dark)}.intro-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:2.5rem}.intro h2,.system-view h2,.process> :global(.container)>h2{max-width:14ch;margin:0;font-size:clamp(2.6rem,6vw,5.7rem);font-weight:500;letter-spacing:-.055em;line-height:.93}.intro-grid p{max-width:36rem;margin:0 0 1.25rem;color:var(--text-dark-secondary);font-size:1rem}.intro-grid strong{font-size:1.15rem}.services-list{background:var(--navy-900)}.services-list article{display:grid;grid-template-columns:minmax(0,1fr);gap:2.5rem;padding-block:clamp(4.5rem,9vw,8rem);border-top:1px solid var(--dark-border)}.services-list article:first-child{border-top:0}.services-list header>span{color:var(--warm-accent);font-size:.68rem}.services-list h2{max-width:14ch;margin:.8rem 0 0;font-size:clamp(2.4rem,5vw,4.5rem);font-weight:500;letter-spacing:-.05em;line-height:.95}.services-list header p{max-width:40rem;margin:1.5rem 0 0;color:var(--text-light-secondary);font-size:1.05rem}.service-details{display:grid;grid-template-columns:minmax(0,1fr);gap:2rem}.service-details h3{margin:0 0 1rem;color:var(--blue-hover);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.service-details h3:not(:first-child){margin-top:2rem}.tags,.platforms{display:flex;flex-wrap:wrap;gap:.5rem;margin:0;padding:0;list-style:none}.tags li,.platforms li{padding:.4rem .65rem;border:1px solid var(--dark-border);border-radius:999px;color:var(--text-light-secondary);font-size:.74rem}.problem-list{display:grid;gap:.7rem;margin:0;padding:0;list-style:none}.problem-list li{padding-bottom:.7rem;border-bottom:1px solid var(--dark-border);color:var(--text-light-secondary)}.problem-list li::before{margin-right:.7rem;color:var(--blue);content:'—'}.service-note{margin:1.5rem 0 0;padding-left:1rem;border-left:2px solid var(--warm-accent);color:var(--text-light-secondary);font-size:.9rem}.system-view{padding-block:var(--section-space);background:var(--navy-950)}.system-view h2{max-width:15ch}.system-view ol{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin:3rem 0 0;padding:0;list-style:none}.system-view li{position:relative;display:grid;min-height:58px;place-items:center;border:1px solid var(--dark-border);border-radius:9px;background:var(--navy-800);color:var(--text-light-secondary)}.system-view li:not(:last-child)::after{position:absolute;bottom:-19px;color:var(--blue);content:'↓'}.system-view li:has(span){grid-template-columns:1fr 1fr;gap:1px;padding:0;border:0;background:var(--dark-border)}.system-view li span{width:100%;height:100%;display:grid;place-items:center;background:var(--navy-800)}.process ol{display:grid;grid-template-columns:minmax(0,1fr);margin:3rem 0 0;padding:0;border-top:1px solid var(--light-border);list-style:none}.process li{padding:1.5rem 0;border-bottom:1px solid var(--light-border)}.process li span{color:var(--blue);font-size:.7rem}.process h3{margin:.5rem 0;font-size:1.6rem;font-weight:500}.process li p{margin:0;color:var(--text-dark-secondary)}
.tags li,.platforms li{font-size:.75rem}
@media(min-width:768px){.intro-grid{grid-template-columns:7fr 5fr;gap:5rem;align-items:end}.services-list article{grid-template-columns:5fr 7fr}.service-details{grid-template-columns:1fr 1fr}.process ol{grid-template-columns:repeat(5,minmax(0,1fr))}.process li{padding:1.5rem}.process li+li{border-left:1px solid var(--light-border)}.system-view ol{grid-template-columns:repeat(7,minmax(0,1fr));gap:0}.system-view li{border-radius:0}.system-view li:not(:last-child)::after{right:-5px;bottom:auto;z-index:1;content:'→'}.system-view li:has(span){grid-template-columns:1fr;gap:1px}.service-visual i{transform:none}}
@media(max-width:767px){.hero-actions{display:grid}.hero-actions :global(a){width:100%}}
</style>
<style>
  .light-section{background:var(--cool-white)}
  .services-list{background:var(--soft-blue);color:var(--text-dark);padding-block:clamp(2rem,5vw,4rem)}
  .services-list article{margin-block:1rem;padding:clamp(1.5rem,5vw,4rem);border:1px solid var(--light-border);border-radius:var(--radius-lg);background:var(--pure-white)}
  .services-list article:first-child{border-top:1px solid var(--light-border)}
  .services-list header>span,.service-details h3{color:var(--blue)}
  .services-list header p,.tags li,.platforms li,.problem-list li,.service-note{color:var(--text-dark-secondary)}
  .tags li,.platforms li,.problem-list li{border-color:var(--light-border)}
  .tags li,.platforms li{background:var(--cool-white)}
  .system-view{background:var(--dark-section)}
</style>
<style>.representative-heading{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;margin-bottom:clamp(2.5rem,5vw,4rem)}.representative-heading h2{max-width:15ch;margin:0;font-size:clamp(2.4rem,5vw,4.6rem);font-weight:500;letter-spacing:-.05em;line-height:.95}.representative-heading p{max-width:32rem;margin:0;color:var(--text-dark-secondary)}@media(min-width:768px){.representative-heading{grid-template-columns:7fr 5fr;align-items:end}}</style>
