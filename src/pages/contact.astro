---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import PageHero from '../components/ui/PageHero.astro';
const services=['AI & Automation','CRM & Revenue Systems','Web App / Internal Tool','Website / Conversion System','Integration / API','Not Sure Yet'];
---
<BaseLayout title="Start a Project | SAMDIGITALS" description="Start a conversation about disconnected tools, manual workflows, poor follow-up, scattered data, or a business system that no longer scales.">
<PageHero eyebrow="START A PROJECT" title="Tell me what's not working." description="If your business is dealing with disconnected tools, manual workflows, poor follow-up, scattered data, or a system that no longer scales, tell me what is happening. We can start with the problem before deciding what technology belongs in the solution."/>
<section class="contact-section"><Container><div class="contact-grid">
<form id="project-inquiry" action="https://formspree.io/f/xdeoaqvd" method="POST" novalidate data-backend="formspree">
<input class="honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true"/><input type="hidden" name="_subject" value="New SAMDIGITALS Project Inquiry"/>
<div class="error-summary" role="alert" tabindex="-1" hidden><strong>Please review the highlighted fields.</strong><ul></ul></div>
<div class="form-fields">
<div class="field-row"><div class="field"><label for="name">Name <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required aria-describedby="name-error"/><p class="field-error" id="name-error"></p></div><div class="field"><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error"/><p class="field-error" id="email-error"></p></div></div>
<div class="field-row"><div class="field"><label for="company">Company / Organization</label><input id="company" name="company" autocomplete="organization"/></div><div class="field"><label for="website">Website <span>Optional</span></label><input id="website" name="website" type="url" inputmode="url" autocomplete="url" placeholder="https://"/></div></div>
<fieldset><legend>What do you need help with? <span aria-hidden="true">*</span></legend><div class="option-grid">{services.map(service=><label><input type="radio" name="service" value={service} aria-describedby="service-error" required/><span>{service}</span></label>)}</div><p class="field-error" id="service-error"></p></fieldset>
<div class="field"><label for="message">Project / Problem Description <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="7" required aria-describedby="message-help message-error"></textarea><p class="help" id="message-help">Describe the workflow, where it breaks down, and what should work better.</p><p class="field-error" id="message-error"></p></div>
<div class="field-row"><div class="field"><label for="budget">Budget Range <span>Optional</span></label><select id="budget" name="budget"><option value="">Select if known</option><option>Under $5,000</option><option>$5,000–$15,000</option><option>$15,000–$30,000</option><option>$30,000+</option><option>Not sure yet</option></select></div><div class="field"><label for="timeline">Timeline <span>Optional</span></label><select id="timeline" name="timeline"><option value="">Select if known</option><option>As soon as practical</option><option>Within 1–3 months</option><option>Within 3–6 months</option><option>Exploring options</option></select></div></div>
<button class="submit-button" type="submit"><span class="button-label">Start the Conversation</span><span aria-hidden="true">→</span></button>
</div>
<div class="submission-failure" role="alert" tabindex="-1" hidden><strong>Something went wrong while sending your inquiry.</strong><p>Please check your connection and try again.</p><button class="retry-button" type="button">Try Again</button></div>
<section class="submission-success" tabindex="-1" aria-labelledby="success-title" hidden><Eyebrow>INQUIRY RECEIVED</Eyebrow><h2 id="success-title">Thanks for reaching out.</h2><p>Your project details have been submitted successfully. I’ll review what you shared and follow up using the email address provided.</p><div class="success-actions"><a href="/">Back to Home</a><a href="/work/">View Selected Work</a></div></section>
</form>
<aside class="fit-panel"><section><Eyebrow>GOOD FIT FOR</Eyebrow><ul><li>CRM cleanup and architecture</li><li>Automation</li><li>System integrations</li><li>Web applications</li><li>Operational workflows</li><li>Reporting infrastructure</li></ul></section><section><Eyebrow>NOT NECESSARILY</Eyebrow><p>Projects focused solely on one-off graphic design, generic logo work, or unrelated commodity tasks may be better served by a specialist in those areas.</p></section></aside>
</div></Container></section>
<section class="next-steps"><Container><Eyebrow>WHAT HAPPENS NEXT</Eyebrow><ol><li><span>01</span><h2>You explain the problem.</h2></li><li><span>02</span><h2>I review the workflow and context.</h2></li><li><span>03</span><h2>We determine the right next step.</h2></li></ol></Container></section>
</BaseLayout>
<script>
const form=document.querySelector<HTMLFormElement>('#project-inquiry');
const rules={name:{message:'Enter your name.',valid:(field:HTMLInputElement)=>field.value.trim().length>0},email:{message:'Enter a valid email address.',valid:(field:HTMLInputElement)=>field.validity.valid&&field.value.trim().length>0},message:{message:'Describe the project or problem.',valid:(field:HTMLTextAreaElement)=>field.value.trim().length>0}};
const setError=(field:HTMLInputElement|HTMLTextAreaElement,message='')=>{const error=document.querySelector<HTMLElement>(`#${field.id}-error`);field.setAttribute('aria-invalid',String(Boolean(message)));if(error)error.textContent=message};
const validate=()=>{if(!form)return[];const errors:{field:HTMLElement;message:string}[]=[];Object.entries(rules).forEach(([id,rule])=>{const field=document.querySelector<HTMLInputElement|HTMLTextAreaElement>(`#${id}`)!;const message=rule.valid(field as never)?'':rule.message;setError(field,message);if(message)errors.push({field,message})});const service=form.querySelector<HTMLInputElement>('input[name="service"]:checked');const serviceError=document.querySelector<HTMLElement>('#service-error');if(serviceError)serviceError.textContent=service?'':'Select the service area that best matches the problem.';form.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach(input=>input.setAttribute('aria-invalid',String(!service)));if(!service)errors.push({field:form.querySelector<HTMLInputElement>('input[name="service"]')!,message:'Select a service area.'});const summary=form.querySelector<HTMLElement>('.error-summary')!;summary.querySelector('ul')!.replaceChildren(...errors.map(({message})=>Object.assign(document.createElement('li'),{textContent:message})));summary.hidden=errors.length===0;return errors};
const setSubmitting=(active:boolean)=>{if(!form)return;const button=form.querySelector<HTMLButtonElement>('.submit-button')!;button.disabled=active;button.setAttribute('aria-busy',String(active));button.querySelector<HTMLElement>('.button-label')!.textContent=active?'Sending...':'Start the Conversation'};
const submitForm=async()=>{if(!form||form.dataset.submitting==='true')return;const failure=form.querySelector<HTMLElement>('.submission-failure')!;failure.hidden=true;form.dataset.submitting='true';setSubmitting(true);try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Submission failed');const fields=form.querySelector<HTMLElement>('.form-fields')!;const summary=form.querySelector<HTMLElement>('.error-summary')!;const success=form.querySelector<HTMLElement>('.submission-success')!;fields.hidden=true;summary.hidden=true;failure.hidden=true;success.hidden=false;form.reset();success.focus()}catch{failure.hidden=false;failure.focus()}finally{form.dataset.submitting='false';setSubmitting(false)}};
form?.addEventListener('submit',event=>{event.preventDefault();const errors=validate();if(errors.length){form.querySelector<HTMLElement>('.error-summary')?.focus();errors[0].field.focus();return}void submitForm()});
form?.querySelector<HTMLButtonElement>('.retry-button')?.addEventListener('click',()=>void submitForm());
form?.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('input[required],textarea[required]').forEach(field=>field.addEventListener('input',()=>{if(field.getAttribute('aria-invalid')==='true')setError(field,'')}));
</script>
<style>
.contact-section{padding-block:var(--section-space);background:var(--light-100);color:var(--text-dark)}.contact-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:3rem}form{min-width:0}.field-row{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}.field,fieldset{margin:0 0 1.5rem}label,legend{display:block;margin-bottom:.55rem;font-size:.82rem;font-weight:650}label>span{color:var(--text-dark-secondary);font-size:.7rem;font-weight:400}input,select,textarea{width:100%;min-height:50px;border:1px solid var(--light-border);border-radius:8px;padding:.75rem;background:var(--light-100);color:var(--text-dark)}textarea{min-height:170px;resize:vertical}input:focus,select:focus,textarea:focus{border-color:var(--blue);outline:2px solid var(--blue-soft);outline-offset:1px}input[aria-invalid=true],textarea[aria-invalid=true]{border-width:2px;border-color:var(--warm-accent)}fieldset{padding:0;border:0}.option-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:.5rem}.option-grid label{position:relative;margin:0}.option-grid input{position:absolute;width:1px;height:1px;opacity:0}.option-grid span{display:flex;min-height:50px;align-items:center;padding:.75rem;border:1px solid var(--light-border);border-radius:8px;color:var(--text-dark);font-size:.82rem}.option-grid input:checked+span{border-width:2px;border-color:var(--blue);background:var(--blue-soft)}.option-grid input:focus-visible+span{outline:2px solid var(--blue);outline-offset:2px}.help,.field-error{margin:.4rem 0 0;font-size:.75rem}.help{color:var(--text-dark-secondary)}.field-error{min-height:1.2em;color:#9a3412;font-weight:600}.field-error:not(:empty)::before{content:'Error: '}.submit-button,.retry-button,.success-actions a{display:inline-flex;min-height:50px;align-items:center;justify-content:center;gap:.7rem;padding:.8rem 1.35rem;border:0;border-radius:10px;background:var(--blue);color:white;font-weight:650;text-decoration:none;cursor:pointer}.submit-button:hover,.retry-button:hover,.success-actions a:hover{background:var(--blue-hover)}.submit-button:disabled{cursor:wait;opacity:.72}.error-summary,.submission-failure{margin:0 0 1.5rem;padding:1rem;border-left:3px solid var(--warm-accent);background:var(--light-200)}.error-summary ul{margin:.5rem 0 0}.submission-failure{margin-top:1rem}.submission-failure p{margin:.5rem 0 1rem}.submission-success{padding:clamp(1.5rem,5vw,3rem);border:1px solid var(--light-border);background:var(--light-200)}.submission-success h2{margin:.75rem 0 1rem;font-size:clamp(2rem,7vw,3.5rem);line-height:1}.submission-success p{max-width:58ch;color:var(--text-dark-secondary)}.success-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}.success-actions a+a{border:1px solid var(--light-border);background:transparent;color:var(--text-dark)}.honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;min-height:0!important;opacity:0!important;pointer-events:none!important}.fit-panel{align-self:start;padding:1.5rem;border:1px solid var(--light-border);border-radius:var(--radius-lg);background:var(--light-200)}.fit-panel section+section{margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--light-border)}.fit-panel ul{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.fit-panel li{padding-bottom:.65rem;border-bottom:1px solid var(--light-border);color:var(--text-dark-secondary)}.fit-panel li::before{margin-right:.6rem;color:var(--blue);content:'—'}.fit-panel p{margin:0;color:var(--text-dark-secondary)}.next-steps{padding-block:var(--section-space);background:var(--navy-900)}.next-steps ol{display:grid;grid-template-columns:minmax(0,1fr);margin:3rem 0 0;padding:0;border-top:1px solid var(--dark-border);list-style:none}.next-steps li{padding:1.5rem 0;border-bottom:1px solid var(--dark-border)}.next-steps span{color:var(--blue-hover);font-size:.68rem}.next-steps h2{max-width:18ch;margin:1rem 0 0;font-size:clamp(1.5rem,4vw,2.2rem);font-weight:500;line-height:1.1}
@media(min-width:700px){.field-row,.option-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.next-steps ol{grid-template-columns:repeat(3,minmax(0,1fr))}.next-steps li{padding:2rem}.next-steps li+li{border-left:1px solid var(--dark-border)}}@media(min-width:1024px){.contact-grid{grid-template-columns:7fr 5fr;gap:5rem}.fit-panel{position:sticky;top:2rem}}@media(max-width:767px){.submit-button,.retry-button,.success-actions a{width:100%}}
</style>
<style>
@media(max-width:767px){input,select,textarea{font-size:1rem}}
.submit-button:hover,.retry-button:hover,.success-actions a:hover{background:var(--blue-strong)}
</style>
<style>
  .contact-section{background:var(--soft-blue)}
  #project-inquiry{padding:clamp(1.25rem,4vw,2.5rem);border:1px solid var(--light-border);border-radius:var(--radius-lg);background:var(--pure-white)}
  input,select,textarea{background:var(--pure-white)}
  .fit-panel{background:var(--cool-white)}
  .next-steps{background:var(--pure-white);color:var(--text-dark)}.next-steps ol,.next-steps li{border-color:var(--light-border)}.next-steps span{color:var(--blue)}
</style>
