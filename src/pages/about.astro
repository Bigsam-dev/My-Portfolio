---
import BaseLayout from '../layouts/BaseLayout.astro';import Container from '../components/layout/Container.astro';import Eyebrow from '../components/ui/Eyebrow.astro';import PageHero from '../components/ui/PageHero.astro';import FinalCTA from '../components/ui/FinalCTA.astro';
import {getSiteMedia} from '../lib/sanity/content';const siteMedia=await getSiteMedia();
const principles=['Understand the workflow before touching the software.','Connect systems instead of adding more isolated tools.','Automate only where automation creates real leverage.','Design for the people who actually have to use the system.'];
const capabilities=[['AI & Automation',['AI Agents','Make','n8n','Zapier','Brevo']],['CRM',['Zoho','GoHighLevel','HubSpot','Clio','JobTread']],['Web Systems',['Web Apps','Internal Tools','Shopify']],['Data & Analytics',['Dashboards','Attribution','Reporting']],['APIs & Integrations',['Custom APIs','System Integration','Data Flow']]];
const expectations=['Clear system thinking','Documented workflows','Practical architecture','Honest scope boundaries','Mobile-conscious implementation','Integration-first thinking','Testing before handoff','Maintainability over unnecessary complexity'];
---
<BaseLayout title="About SAMDIGITALS — Systems, Automation & CRM" description="A systems-first approach to AI automation, CRM infrastructure, web applications, APIs, data, and practical business operations.">
<PageHero eyebrow="ABOUT" title={"I don't start with tools.\nI start with the system."} description="The best technical solution usually begins with understanding how the business actually works — where information enters, where it gets delayed, where teams repeat work, and what happens downstream." split>{siteMedia?.portrait?.url?<figure slot="visual" class="profile-media"><img src={siteMedia.portrait.url} srcset={siteMedia.portrait.srcset} sizes="(max-width: 899px) calc(100vw - 40px), 38vw" alt={siteMedia.portrait.altText||''} width="900" height="1125" loading="eager" decoding="async" fetchpriority="high"/></figure>:<div slot="visual" class="identity-visual" aria-label="Abstract SAMDIGITALS identity representing connected systems"><strong>SD<span>.</span></strong><div aria-hidden="true"><i></i><i></i><i></i><i></i></div><small>SYSTEMS / STRATEGY / BUILD</small></div>}</PageHero>
<section class="philosophy"><Container><Eyebrow>CORE PHILOSOPHY</Eyebrow><div class="philosophy-grid"><h2>Tools change.<br/>Good systems thinking doesn't.</h2><div><p>CRM platforms change.</p><p>Automation tools change.</p><p>AI models change.</p><p>What remains important is understanding the workflow, the data, the people using the system, and the business outcome the system is supposed to support.</p><strong>That is why I approach projects from architecture first.</strong></div></div></Container></section>
<section class="principles"><Container><Eyebrow>HOW I THINK</Eyebrow><h2>Architecture before implementation.</h2><ol>{principles.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></li>)}</ol></Container></section>
<section class="capability"><Container><div class="capability-heading"><Eyebrow>CAPABILITY MAP</Eyebrow><h2>Tools are building blocks. The connection is the work.</h2></div><div class="capability-list">{capabilities.map(([category,items])=><section><h3>{category}</h3><ul>{(items as string[]).map(item=><li>{item}</li>)}</ul></section>)}</div></Container></section>
{siteMedia?.workingPhoto?.url&&<section class="profile-support" aria-label="Working portrait"><Container><figure><img src={siteMedia.workingPhoto.url} srcset={siteMedia.workingPhoto.srcset} sizes="(max-width: 767px) calc(100vw - 40px), 42vw" alt={siteMedia.workingPhoto.altText||''} width="810" height="1080" loading="lazy" decoding="async"/><figcaption>Systems / Strategy / Build</figcaption></figure></Container></section>}
<section class="expectations"><Container><Eyebrow>WHAT YOU CAN EXPECT</Eyebrow><h2>Practical systems, clearly considered.</h2><ul>{expectations.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span>{item}</li>)}</ul></Container></section>
<FinalCTA eyebrow="THE GOAL" title="The goal isn't more software. It's a business that works better because the systems behind it do." primaryLabel="Start a Project" secondaryLabel="Explore Work"/>
</BaseLayout>
<style>
.identity-visual{position:relative;min-height:420px;padding:2rem;overflow:hidden;border:1px solid var(--dark-border);border-radius:var(--radius-lg);background:var(--navy-900)}.identity-visual::before{position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--text-light-secondary) 5%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--text-light-secondary) 5%,transparent) 1px,transparent 1px);background-size:34px 34px;content:''}.identity-visual strong{position:relative;z-index:1;display:block;margin-top:22%;font-size:clamp(5rem,12vw,9rem);font-weight:600;letter-spacing:-.08em;line-height:1}.identity-visual strong span{color:var(--blue)}.identity-visual div{position:absolute;inset:auto 2rem 5rem;display:grid;gap:8px}.identity-visual i{height:1px;background:var(--dark-border)}.identity-visual i:nth-child(2){width:78%}.identity-visual i:nth-child(3){width:54%;background:var(--blue)}.identity-visual i:nth-child(4){width:27%;background:var(--warm-accent)}.identity-visual small{position:absolute;bottom:2rem;color:var(--text-muted);font-size:.62rem;letter-spacing:.12em}.philosophy,.capability{padding-block:var(--section-space);background:var(--light-100);color:var(--text-dark)}.philosophy-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:2.5rem}.philosophy h2,.principles h2,.capability h2,.expectations h2{max-width:15ch;margin:0;font-size:clamp(2.6rem,6vw,5.5rem);font-weight:500;letter-spacing:-.055em;line-height:.94}.philosophy-grid p{margin:0 0 .85rem;color:var(--text-dark-secondary);font-size:1rem}.philosophy-grid p:nth-child(-n+3){font-size:1.2rem;color:var(--text-dark)}.philosophy-grid strong{display:block;margin-top:1.5rem}.principles{padding-block:var(--section-space);background:var(--navy-900)}.principles ol{display:grid;grid-template-columns:minmax(0,1fr);margin:3rem 0 0;padding:0;border-top:1px solid var(--dark-border);list-style:none}.principles li{padding:1.5rem 0;border-bottom:1px solid var(--dark-border)}.principles span{color:var(--blue-hover);font-size:.68rem}.principles p{max-width:22rem;margin:1rem 0 0;font-size:clamp(1.35rem,3vw,2rem);line-height:1.2}.capability :global(.container){display:grid;grid-template-columns:minmax(0,1fr);gap:3rem}.capability-list{border-top:1px solid var(--light-border)}.capability-list section{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;padding:1.5rem 0;border-bottom:1px solid var(--light-border)}.capability-list h3{margin:0;font-size:1.25rem;font-weight:500}.capability-list ul{display:flex;flex-wrap:wrap;gap:.5rem;margin:0;padding:0;list-style:none}.capability-list li{padding:.35rem .6rem;border:1px solid var(--light-border);border-radius:999px;color:var(--text-dark-secondary);font-size:.75rem}.expectations{padding-block:var(--section-space);background:var(--navy-950)}.expectations ul{display:grid;grid-template-columns:minmax(0,1fr);gap:1px;margin:3rem 0 0;padding:1px;background:var(--dark-border);list-style:none}.expectations li{min-height:92px;padding:1.25rem;background:var(--navy-900);color:var(--text-light-secondary)}.expectations li span{display:block;margin-bottom:.75rem;color:var(--blue-hover);font-size:.65rem}
@media(min-width:768px){.philosophy-grid{grid-template-columns:7fr 5fr;gap:5rem;align-items:end}.principles ol{grid-template-columns:repeat(2,minmax(0,1fr))}.principles li{min-height:210px;padding:2rem}.principles li:nth-child(even){border-left:1px solid var(--dark-border)}.capability :global(.container){grid-template-columns:5fr 7fr;gap:5rem}.capability-list section{grid-template-columns:1fr 1.5fr}.expectations ul{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(min-width:1100px){.principles ol{grid-template-columns:repeat(4,minmax(0,1fr))}.principles li+li{border-left:1px solid var(--dark-border)}.expectations ul{grid-template-columns:repeat(4,minmax(0,1fr))}}
</style>
<style>.principles,.profile-support,.expectations{--eyebrow-color:var(--blue)}</style>
<style>.profile-media{margin:0;overflow:hidden;border:1px solid var(--dark-border);border-radius:var(--radius-lg);background:var(--navy-900)}.profile-media img{display:block;width:100%;height:auto;object-position:50% 0%!important}</style>
<style>.profile-support{padding-block:clamp(4rem,8vw,7rem);background:var(--navy-900)}.profile-support figure{display:grid;grid-template-columns:minmax(0,1fr);width:100%;max-width:36rem;margin:0 auto}.profile-support img{display:block;width:100%;height:auto;object-position:50% 0%;border:1px solid var(--dark-border);border-radius:var(--radius-lg)}.profile-support figcaption{padding-top:.8rem;color:var(--text-muted);font-size:.65rem;letter-spacing:.11em;text-transform:uppercase}</style>
<style>
  .philosophy{background:var(--pure-white)}.capability{background:var(--cool-white)}
  .principles{background:var(--soft-blue);color:var(--text-dark)}.principles ol,.principles li{border-color:var(--light-border)}.principles span{color:var(--blue)}
  .profile-media{border-color:var(--light-border);background:var(--soft-blue)}
  .profile-support{background:var(--pure-white);color:var(--text-dark)}.profile-support img{border-color:var(--light-border)}.profile-support figcaption{color:var(--muted-ink)}
  .expectations{background:var(--cool-white);color:var(--text-dark)}.expectations ul{background:var(--light-border)}.expectations li{background:var(--pure-white);color:var(--text-dark-secondary)}.expectations li span{color:var(--blue)}
</style>
