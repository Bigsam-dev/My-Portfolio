---
import {toHTML} from '@portabletext/to-html';import ArticleLayout from '../../layouts/ArticleLayout.astro';import {getPublishedInsights,getInsightBySlug} from '../../lib/sanity/content';import type {CMSInsight} from '../../lib/sanity/types';
import {absoluteSiteUrl} from '../../config/site';import {sanityImageUrl} from '../../lib/sanity/image';
export async function getStaticPaths(){const entries=await getPublishedInsights();return entries.map(entry=>({params:{slug:entry.slug},props:{entry,related:entries.filter(item=>item._id!==entry._id).slice(0,2)}}))}
interface Props{entry:CMSInsight;related:CMSInsight[]}
const {entry,related}=Astro.props as Props;const fullEntry=await getInsightBySlug(entry.slug)||entry;const bodyHtml=fullEntry.body?toHTML(fullEntry.body):'';
const image=sanityImageUrl(fullEntry.coverImage as never,1200);const articleUrl=absoluteSiteUrl(`/insights/${fullEntry.slug}/`);const publishedAt=fullEntry.publishedAt?new Date(fullEntry.publishedAt):undefined;
const structuredData=[{'@context':'https://schema.org','@type':'Article',headline:fullEntry.title,description:fullEntry.seoDescription||fullEntry.summary,...(publishedAt?{datePublished:publishedAt.toISOString()}:{}),author:{'@type':'Organization',name:'SAMDIGITALS'},publisher:{'@type':'Organization',name:'SAMDIGITALS'},...(articleUrl?{mainEntityOfPage:articleUrl}:{}),...(image?{image}:{})},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',...(absoluteSiteUrl('/')?{item:absoluteSiteUrl('/')}: {})},{'@type':'ListItem',position:2,name:'Insights',...(absoluteSiteUrl('/insights/')?{item:absoluteSiteUrl('/insights/')}: {})},{'@type':'ListItem',position:3,name:fullEntry.title,...(articleUrl?{item:articleUrl}: {})}]}];
---
<ArticleLayout title={`${fullEntry.title} | SAMDIGITALS`} description={fullEntry.seoDescription||fullEntry.summary} category={fullEntry.category} status="published" publishedAt={publishedAt} image={image} structuredData={structuredData}><Fragment slot="title">{fullEntry.title}</Fragment><Fragment slot="summary">{fullEntry.summary}</Fragment><Fragment set:html={bodyHtml}/>{related.map(item=><a slot="related" href={`/insights/${item.slug}/`}>{item.title}</a>)}</ArticleLayout>
