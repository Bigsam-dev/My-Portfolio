---
import BaseLayout from '../../layouts/BaseLayout.astro';import Container from '../../components/layout/Container.astro';import Eyebrow from '../../components/ui/Eyebrow.astro';import PageHero from '../../components/ui/PageHero.astro';import FinalCTA from '../../components/ui/FinalCTA.astro';import {getPublishedInsights} from '../../lib/sanity/content';
const insights=await getPublishedInsights();const categories=['Automation','CRM','AI','System Architecture','APIs','Analytics','Web Systems','Case Studies'];
---
<BaseLayout title="Insights — Automation, CRM & System Architecture | SAMDIGITALS" description="Practical notes on automation, CRM architecture, AI, APIs, analytics, web systems, and implementation decisions.">
<PageHero eyebrow="INSIGHTS" title="Notes from building better systems." description="Practical breakdowns on automation, CRM architecture, AI, APIs, analytics, web systems, and the decisions behind real implementations."/>
<section class="insights-index"><Container><div class="category-row" role="group" aria-label="Insight topics">{categories.map(category=><span>{category}</span>)}</div><div class="index-heading"><Eyebrow>EDITORIAL INDEX</Eyebrow><p>Published notes on system architecture, implementation decisions, and the operational thinking behind connected business systems.</p></div>{insights.length?<ol>{insights.map((entry,index)=><li class:list={{featured:entry.featured}}><a href={`/insights/${entry.slug}/`}><span class="number">{String(index+1).padStart(2,'0')}</span><div><div class="meta"><span>{entry.category}</span></div><h2>{entry.title}</h2><p>{entry.summary}</p></div><span class="arrow" aria-hidden="true">↗</span></a></li>)}</ol>:<p class="empty-state">No insights are published yet. Draft entries remain private until they are ready.</p>}</Container></section>
<FinalCTA title="Have a system question worth unpacking?" description="If the challenge is specific to your business, start with the workflow and context rather than another generic tool recommendation." secondaryLabel="View Work"/>
</BaseLayout>
<style>
.insights-index{padding-block:var(--section-space);background:var(--light-100);color:var(--text-dark)}.category-row{display:flex;flex-wrap:wrap;gap:.5rem}.category-row span{padding:.4rem .65rem;border:1px solid var(--light-border);border-radius:999px;color:var(--text-dark-secondary);font-size:.72rem}.index-heading{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin-top:4rem}.index-heading p{max-width:40rem;margin:0;color:var(--text-dark-secondary)}ol{margin:3rem 0 0;padding:0;border-top:1px solid var(--light-border);list-style:none}li a{display:grid;grid-template-columns:38px minmax(0,1fr) 24px;gap:.75rem;align-items:center;min-height:190px;padding-block:1.5rem;border-bottom:1px solid var(--light-border)}.number{color:var(--blue);font-size:.7rem}.meta{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center}.meta span,.meta b{color:var(--text-dark-secondary);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase}.meta b{padding:.25rem .45rem;border:1px solid var(--light-border);border-radius:999px;font-weight:600}h2{max-width:30ch;margin:.8rem 0 0;font-size:clamp(1.5rem,4vw,2.5rem);font-weight:500;letter-spacing:-.04em;line-height:1.05}li p{max-width:46rem;margin:1rem 0 0;color:var(--text-dark-secondary);font-size:1rem}.arrow{justify-self:end;color:var(--blue);font-size:1.2rem}
@media(min-width:768px){.index-heading{grid-template-columns:1fr 1fr;align-items:start}li a{grid-template-columns:70px minmax(0,1fr) 40px;gap:2rem;padding:2.5rem 0}.featured a{min-height:280px}.featured h2{font-size:clamp(2.5rem,4.5vw,4.5rem)}}
</style>
<style>.empty-state{margin:3rem 0 0;padding:2rem 0;border-top:1px solid var(--light-border);border-bottom:1px solid var(--light-border);color:var(--text-dark-secondary)}</style>
