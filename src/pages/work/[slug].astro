---
import type { CMSProject } from '../../lib/sanity/types';
import { getCaseStudyProjects } from '../../lib/sanity/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import ProjectPreview from '../../components/home/ProjectPreview.astro';
import WorkflowDiagram from '../../components/work/WorkflowDiagram.astro';
import {absoluteSiteUrl} from '../../config/site';
export async function getStaticPaths(){const projects=await getCaseStudyProjects();return projects.map((project,index)=>({params:{slug:project.slug},props:{project,nextProject:projects[(index+1)%projects.length]}}));}
interface Props{project:CMSProject;nextProject:CMSProject}
const {project:p,nextProject}=Astro.props;
const statusLabels={delivered:'Delivered','in-progress':'In Progress',ongoing:'Ongoing',architecture:'System Architecture',concept:'Concept'};
const meta=[{label:'Industry',value:p.industry},{label:'Role',value:p.role},{label:'Status',value:p.status?statusLabels[p.status]:undefined},{label:'Timeline',value:p.timeline},{label:'Services',value:p.services.join(' · ')},{label:'Technology',value:p.tech.join(' · ')}].filter((item):item is {label:string;value:string}=>Boolean(item.value));
const pageTitle=`${p.title} — ${p.category} | SAMDIGITALS`;
const projectUrl=absoluteSiteUrl(`/work/${p.slug}/`);
const structuredData=[{'@context':'https://schema.org','@type':'CreativeWork',name:p.title,description:p.seoDescription||p.summary,genre:p.category,...(projectUrl?{url:projectUrl}:{}),...(p.coverUrl?{image:p.coverUrl}:{})},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',...(absoluteSiteUrl('/')?{item:absoluteSiteUrl('/')}: {})},{'@type':'ListItem',position:2,name:'Work',...(absoluteSiteUrl('/work/')?{item:absoluteSiteUrl('/work/')}: {})},{'@type':'ListItem',position:3,name:p.title,...(projectUrl?{item:projectUrl}: {})}]}];
---
<BaseLayout title={pageTitle} description={p.seoDescription||p.summary} image={p.coverUrl} imageAlt={`${p.title} project cover`} type="article" structuredData={structuredData}>
<article>
  <header class="case-hero"><Container><div class="hero-kicker"><Eyebrow>PROJECT / CASE STUDY</Eyebrow>{p.status&&<span class="status">{statusLabels[p.status]}</span>}</div><h1>{p.title}</h1><p class="category">{p.category}</p><p class="summary">{p.summary}</p><dl>{meta.map(item=><div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl><div class="hero-visual"><ProjectPreview type={p.visualType}/></div></Container></header>
  {(p.problem||p.businessContext)&&<section class="case-section case-light" aria-labelledby="problem-title"><Container><div class="editorial-grid"><div><Eyebrow>THE PROBLEM</Eyebrow>{p.problem&&<h2 id="problem-title">{p.problem}</h2>}</div>{p.businessContext&&<div class="context"><span>BUSINESS CONTEXT</span><p>{p.businessContext}</p></div>}</div></Container></section>}
  {(p.solution||p.system.length||p.workflow.length)&&<section class="case-section system-section" aria-labelledby="system-title"><Container><div class="section-heading"><Eyebrow>THE SYSTEM</Eyebrow>{p.solution&&<h2 id="system-title">{p.solution}</h2>}</div>{p.system.length>0&&<ul class="system-list" aria-label="System layers">{p.system.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{item}</strong></li>)}</ul>}{p.workflow.length>0&&<div class="workflow-wrap"><p>WORKFLOW / ARCHITECTURE</p><WorkflowDiagram title={`${p.title} workflow`} steps={p.workflow}/></div>}</Container></section>}
  {p.implementation.length>0&&<section class="case-section case-light" aria-labelledby="implementation-title"><Container><div class="section-heading dark"><Eyebrow>IMPLEMENTATION</Eyebrow><h2 id="implementation-title">The project system, broken into clear working layers.</h2></div><ol class="implementation-list">{p.implementation.map((item,index)=><li><span>{String(item.order||index+1).padStart(2,'0')}</span><h3>{item.title}</h3>{item.description&&<p>{item.description}</p>}</li>)}</ol></Container></section>}
  {p.screenshots.length>0&&<section class="case-section gallery" aria-labelledby="gallery-title"><Container><Eyebrow>INTERFACE / SCREENSHOTS</Eyebrow><h2 id="gallery-title">Project interfaces</h2><div class="gallery-grid">{p.screenshots.map(item=><figure class={`screenshot screenshot--${item.displayStyle}`}><div>{item.url&&<img src={item.url} srcset={item.srcset} sizes={item.displayStyle==='mobile'?'(max-width: 767px) calc(100vw - 40px), 420px':'(max-width: 767px) calc(100vw - 40px), 80vw'} alt={item.altText} loading="lazy" decoding="async" width="1600" height="900"/>}</div>{(item.title||item.caption)&&<figcaption>{item.title&&<strong>{item.title}</strong>}{item.caption&&<span>{item.caption}</span>}</figcaption>}</figure>)}</div></Container></section>}
  {p.tech.length>0&&<section class="case-section case-light technology-section" aria-labelledby="technology-title"><Container><Eyebrow>TECHNOLOGY</Eyebrow><h2 id="technology-title">The project stack.</h2><ul>{p.tech.map(item=><li>{item}</li>)}</ul></Container></section>}
  {p.outcomes.length>0&&<section class="case-section case-light"><Container><Eyebrow>PROJECT OUTCOMES</Eyebrow><ul>{p.outcomes.map(item=><li>{item}</li>)}</ul></Container></section>}
  {p.metrics.length>0&&<section class="case-section case-light"><Container><Eyebrow>VERIFIED METRICS</Eyebrow><dl class="metrics">{p.metrics.map(item=><div><dt>{item.label}</dt><dd>{item.value}</dd>{item.context&&<small>{item.context}</small>}</div>)}</dl></Container></section>}
  {p.testimonial&&<section class="case-section"><Container><Eyebrow>CLIENT FEEDBACK</Eyebrow><blockquote><p>“{p.testimonial.quote}”</p><cite>{[p.testimonial.clientName,p.testimonial.role,p.testimonial.company].filter(Boolean).join(' · ')}</cite></blockquote></Container></section>}
  <nav class="next-project" aria-label="Next project"><Container><p>NEXT PROJECT</p><a href={`/work/${nextProject.slug}/`}><span><strong>{nextProject.title}</strong><small>{nextProject.category}</small></span><b aria-hidden="true">→</b></a></Container></nav>
  <section class="case-cta" aria-labelledby="case-cta-title"><Container><div><Eyebrow>HAVE A SYSTEM THAT SHOULD WORK BETTER?</Eyebrow><h2 id="case-cta-title">Let's design a cleaner way for your business to operate.</h2></div><div class="cta-buttons"><Button href="/contact/">Start a Project</Button><Button href="/work/" variant="secondary">View All Work</Button></div></Container></section>
</article>
</BaseLayout>
<style>
.case-hero{padding-block:clamp(8rem,13vw,11rem) clamp(5rem,8vw,7rem);background:var(--navy-950)}.hero-kicker{display:flex;justify-content:space-between;gap:1rem;align-items:start}.status{padding:.4rem .65rem;border:1px solid var(--dark-border);border-radius:999px;color:var(--text-light-secondary);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}.case-hero h1{max-width:13ch;margin:0;font-size:clamp(3rem,8vw,7.5rem);font-weight:500;letter-spacing:-.06em;line-height:.88}.category{margin:1rem 0 0;color:var(--blue-hover);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.summary{max-width:54rem;margin:1.5rem 0 0;color:var(--text-light-secondary);font-size:clamp(1.05rem,1.8vw,1.35rem)}dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:clamp(3rem,6vw,5rem) 0 0;background:var(--dark-border);border:1px solid var(--dark-border)}dl div{min-width:0;padding:1.25rem;background:var(--navy-950)}dt{color:var(--text-muted);font-size:.65rem;letter-spacing:.11em;text-transform:uppercase}dd{margin:.45rem 0 0;color:var(--text-light-secondary);font-size:.88rem;overflow-wrap:anywhere}.hero-visual{margin-top:clamp(3rem,7vw,6rem)}.hero-visual :global(.project-preview){min-height:auto;aspect-ratio:16/9;border-radius:var(--radius-lg)}
.case-section{padding-block:var(--section-space)}.case-light{background:var(--light-100);color:var(--text-dark)}.editorial-grid{display:grid;grid-template-columns:minmax(0,8fr) minmax(280px,4fr);gap:clamp(3rem,8vw,8rem);align-items:end}.editorial-grid h2,.section-heading h2{max-width:18ch;margin:0;font-size:clamp(2.8rem,5.7vw,5.7rem);font-weight:500;letter-spacing:-.055em;line-height:.94}.context{padding-left:1.5rem;border-left:2px solid var(--blue)}.context span,.workflow-wrap>p{color:var(--blue);font-size:.67rem;font-weight:700;letter-spacing:.12em}.context p{margin:1rem 0 0;color:var(--text-dark-secondary);font-size:1rem}.system-section{background:var(--navy-950)}.section-heading h2{max-width:17ch}.system-list{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin:clamp(3rem,6vw,5rem) 0 0;padding:0;border:1px solid var(--dark-border);list-style:none}.system-list li{min-width:0;min-height:170px;padding:1.5rem}.system-list li+li{border-left:1px solid var(--dark-border)}.system-list span{display:block;color:var(--blue-hover);font-size:.68rem}.system-list strong{display:block;margin-top:3rem;font-size:clamp(1rem,2vw,1.3rem);font-weight:500;overflow-wrap:anywhere}.workflow-wrap{margin-top:clamp(3rem,6vw,5rem)}.workflow-wrap>p{margin:0 0 1rem}.implementation-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:clamp(3rem,6vw,5rem) 0 0;padding:0;border-top:1px solid var(--light-border);list-style:none}.implementation-list li{min-width:0;padding:2rem 1.5rem 2rem 0}.implementation-list li+li{padding-left:1.5rem;border-left:1px solid var(--light-border)}.implementation-list span{color:var(--blue);font-size:.7rem}.implementation-list h3{margin:2rem 0 0;font-size:clamp(1.3rem,2.5vw,2rem);font-weight:500;letter-spacing:-.03em;overflow-wrap:anywhere}.technology-section h2{margin:0;font-size:clamp(2.8rem,5vw,5rem);font-weight:500;letter-spacing:-.05em}.technology-section ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin:3rem 0 0;padding:1px;background:var(--light-border);list-style:none}.technology-section li{min-height:100px;padding:1.5rem;background:var(--light-100);font-size:1.1rem}.next-project{padding-block:clamp(4rem,8vw,7rem);border-top:1px solid var(--dark-border);background:var(--navy-900)}.next-project p{margin:0;color:var(--blue-hover);font-size:.68rem;font-weight:700;letter-spacing:.12em}.next-project a{display:flex;justify-content:space-between;gap:2rem;align-items:end;min-height:120px;margin-top:1.25rem}.next-project strong{display:block;font-size:clamp(2.4rem,6vw,5.5rem);font-weight:500;letter-spacing:-.05em;line-height:.95}.next-project small{display:block;margin-top:.8rem;color:var(--text-light-secondary);font-size:.8rem}.next-project b{color:var(--blue);font-size:2rem}.case-cta{padding-block:clamp(5rem,10vw,9rem);border-top:1px solid var(--dark-border);background:var(--navy-950)}.case-cta :global(.container){display:grid;grid-template-columns:7fr 5fr;gap:4rem;align-items:end}.case-cta h2{max-width:15ch;margin:0;font-size:clamp(2.7rem,5vw,5rem);font-weight:500;letter-spacing:-.05em;line-height:.95}.cta-buttons{display:flex;flex-wrap:wrap;gap:.75rem}
@media(max-width:767px){.case-hero{padding-block:8rem 4.5rem}.hero-kicker{display:block}.status{display:inline-block;margin-bottom:1rem}.case-hero h1{font-size:clamp(3rem,15vw,4.35rem)}dl{grid-template-columns:minmax(0,1fr)}.hero-visual :global(.project-preview){aspect-ratio:auto;min-height:250px}.editorial-grid{grid-template-columns:minmax(0,1fr);gap:2.5rem}.editorial-grid h2,.section-heading h2{font-size:clamp(2.4rem,11vw,3.5rem)}.system-list{grid-template-columns:minmax(0,1fr)}.system-list li{display:grid;grid-template-columns:40px minmax(0,1fr);align-items:center;min-height:72px;padding:1rem}.system-list li+li{border-top:1px solid var(--dark-border);border-left:0}.system-list strong{margin:0;font-size:1rem}.implementation-list{grid-template-columns:minmax(0,1fr)}.implementation-list li,.implementation-list li+li{display:grid;grid-template-columns:40px minmax(0,1fr);align-items:center;padding:1.25rem 0;border-left:0;border-bottom:1px solid var(--light-border)}.implementation-list h3{margin:0;font-size:1.35rem}.technology-section ul{grid-template-columns:minmax(0,1fr)}.next-project a{min-height:100px}.next-project strong{font-size:clamp(2.25rem,11vw,3.5rem)}.case-cta :global(.container){grid-template-columns:minmax(0,1fr);gap:2.5rem}.case-cta h2{font-size:clamp(2.5rem,11vw,3.5rem)}.cta-buttons{display:grid}.cta-buttons :global(a){width:100%}}
</style>
<style>
  .case-hero{background:linear-gradient(135deg,var(--royal-blue-dark),var(--royal-blue));border-bottom-color:rgba(255,255,255,.22)}
  .case-hero dl{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.22)}.case-hero dl div{background:rgba(11,31,58,.24)}
  .case-light{background:var(--pure-white)}.case-light:has(.implementation-list){background:var(--soft-blue)}
  .system-section{background:var(--dark-section)}
  .gallery{background:var(--pure-white);color:var(--text-dark)}.gallery .screenshot>div{border-color:var(--light-border);background:var(--cool-white)}.gallery .screenshot figcaption{color:var(--text-dark-secondary)}.gallery .screenshot figcaption strong{color:var(--text-dark)}
  .next-project,.case-cta{--button-primary-bg:var(--pure-white);--button-primary-text:var(--royal-blue-dark);--button-primary-hover:var(--soft-blue);--button-secondary-bg:transparent;--button-secondary-text:var(--pure-white);--button-secondary-border:rgba(255,255,255,.55);--button-secondary-hover:rgba(255,255,255,.1);background:var(--royal-blue);border-color:rgba(255,255,255,.22)}
  .next-project p,.next-project b{color:var(--pure-white)}
</style>
<style>.workflow-wrap>p{color:var(--blue-hover)}</style>
<style>
.gallery{background:var(--navy-900)}.gallery h2{margin:0;font-size:clamp(2.8rem,5vw,5rem);font-weight:500;letter-spacing:-.05em}.gallery-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:1.25rem;margin-top:3rem}.screenshot{min-width:0;margin:0}.screenshot>div{overflow:hidden;border:1px solid var(--dark-border);border-radius:var(--radius-md);background:var(--navy-950)}.screenshot img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}.screenshot--browser-frame>div{padding-top:28px;background:linear-gradient(var(--navy-800) 0 28px,var(--navy-950) 28px)}.screenshot--dashboard>div{padding:clamp(.75rem,3vw,2rem)}.screenshot--mobile{max-width:420px;justify-self:center}.screenshot--mobile img{aspect-ratio:9/16}.screenshot--detail-crop img{aspect-ratio:2/1;object-fit:cover}.screenshot figcaption{display:grid;gap:.3rem;padding-top:.75rem;color:var(--text-light-secondary);font-size:.85rem}.screenshot figcaption strong{color:var(--text-light)}.implementation-list p{grid-column:2;margin:.6rem 0 0;color:var(--text-dark-secondary);font-size:.9rem}.metrics{grid-template-columns:repeat(2,minmax(0,1fr));background:var(--light-border);border-color:var(--light-border)}.metrics div{background:var(--light-100)}.metrics dt{color:var(--text-dark-secondary)}.metrics dd{color:var(--text-dark);font-size:1.6rem}.metrics small{display:block;margin-top:.5rem;color:var(--text-dark-secondary)}
@media(min-width:768px){.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.screenshot--full-width,.screenshot--browser-frame,.screenshot--dashboard{grid-column:1/-1}.screenshot--split{grid-column:auto}.screenshot--detail-crop{grid-column:1/-1}}
@media(max-width:767px){.metrics{grid-template-columns:minmax(0,1fr)}.implementation-list p{grid-column:2}}
</style>
<style>
  .gallery{background:var(--pure-white);color:var(--text-dark)}
  .gallery .screenshot>div{border-color:var(--light-border);background:var(--cool-white)}
  .gallery .screenshot figcaption{color:var(--text-dark-secondary)}.gallery .screenshot figcaption strong{color:var(--text-dark)}
</style>
