---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import SoftwareMarquee from '../components/home/SoftwareMarquee.astro';
import SystemArchitecture from '../components/home/SystemArchitecture.astro';
import ProjectCard from '../components/work/ProjectCard.astro';
import { getFeaturedProjects, getSiteMedia } from '../lib/sanity/content';
import { absoluteSiteUrl, siteConfig } from '../config/site';
const projects = await getFeaturedProjects();
const siteMedia = await getSiteMedia();
const organizationSchema={
  '@context':'https://schema.org','@type':'Organization',name:siteConfig.siteName,
  ...(absoluteSiteUrl('/')?{url:absoluteSiteUrl('/'),logo:absoluteSiteUrl('/favicon.svg')}:{}),
  description:siteConfig.defaultDescription,
};

const services = [
  { number: '01', title: 'AI & Business Automation', description: 'Automate repetitive workflows and move information without manual handoffs.', capabilities: ['AI Agents','Workflow Design','API Automation'] },
  { number: '02', title: 'CRM & Revenue Systems', description: 'Connect lead capture, follow-up, pipeline activity, and reporting.', capabilities: ['CRM Architecture','Pipelines','Reporting'] },
  { number: '03', title: 'Web Apps & Internal Tools', description: 'Build focused interfaces around workflows standard software cannot handle.', capabilities: ['Dashboards','Portals','Internal Tools'] },
  { number: '04', title: 'Conversion-Focused Websites', description: 'Turn websites into connected parts of the customer and revenue system.', capabilities: ['Lead Capture','CRM Integration','Conversion Paths'] },
];

---
<BaseLayout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription} structuredData={organizationSchema} headerVariant="floating">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true"><img src="/images/samdigitals-hero.png" alt="" width="1672" height="941" loading="eager" decoding="async" fetchpriority="high"/></div>
    <Container><div class="hero-grid"><div class="hero-copy"><Eyebrow>AI AUTOMATION / CRM / WEB SYSTEMS</Eyebrow><h1 id="hero-title">I Build the Systems Behind Growing Businesses.</h1><p class="hero-lede">I design and build AI automation, CRM infrastructure, custom web apps, and conversion-focused websites that connect operations, data, and revenue.</p><div class="button-row"><Button href="/work/">View Selected Work</Button><Button href="/contact/" variant="secondary">Start a Project</Button></div><p class="credibility"><span aria-hidden="true"></span>Built for businesses that have outgrown manual processes and disconnected tools.</p><SoftwareMarquee/></div></div></Container>
  </section>

  <section id="featured-work" class="section featured-work" aria-labelledby="work-title"><Container><SectionHeading eyebrow="01 / SELECTED WORK" title="Systems built around real business problems." description="A selection of CRM, automation, analytics, website, and operational systems designed to remove friction and make businesses easier to run." id="work-title"/><div class="projects-grid">{projects.map((project,index)=><ProjectCard project={project} featured={index===0}/>)}</div><a class="section-link" href="/work/">View All Work <span aria-hidden="true">→</span></a></Container></section>

  <section id="services" class="section section-light services" aria-labelledby="services-title"><Container><SectionHeading eyebrow="03 / WHAT I BUILD" title="Digital infrastructure built around how your business actually works." light id="services-title"/><div class="services-grid">{services.map(service=><article class="service-panel"><div class="service-top"><span>{service.number}</span><span class="service-mark" aria-hidden="true"></span></div><h3>{service.title}</h3><p>{service.description}</p><ul class="capabilities" aria-label={`${service.title} capabilities`}>{service.capabilities.map(item=><li>{item}</li>)}</ul></article>)}</div><a class="section-link section-link--dark" href="/services/">Explore Services <span aria-hidden="true">→</span></a></Container></section>

  <section id="architecture" class="section architecture-section" aria-labelledby="architecture-title"><Container><div class="section-intro-grid"><SectionHeading eyebrow="04 / CONNECT THE BUSINESS" title="One business. One connected system." id="architecture-title"/><div class="section-side-copy"><p>A website should not stop at a form submission. A CRM should not become a data graveyard. Automation should not create more complexity than it removes.</p><p>I connect the layers so information can move from acquisition to operations, analytics, and revenue with less friction.</p></div></div><SystemArchitecture/></Container></section>

  <section id="about" class="section about" aria-labelledby="about-title"><Container><div class="about-grid">{siteMedia?.portrait?.url?<figure class="about-portrait"><img src={siteMedia.portrait.url} srcset={siteMedia.portrait.srcset} sizes="(max-width: 767px) calc(100vw - 40px), 42vw" alt={siteMedia.portrait.altText||''} width="900" height="1125" loading="lazy" decoding="async"/></figure>:<div class="identity-visual" aria-label="Abstract identity composition representing connected systems"><span class="identity-wordmark">SD<span>.</span></span><div class="identity-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div><p>Systems / Strategy / Build</p></div>}<div class="about-copy"><Eyebrow>ABOUT</Eyebrow><h2 id="about-title">I don't start with tools. I start with the system.</h2><p>My approach comes from thinking in systems: understanding how each part affects what happens downstream.</p><p>I design the connections between acquisition, operations, data, automation, and revenue—then choose the right building blocks for the work.</p><a class="section-link" href="/about/">More About Me <span aria-hidden="true">→</span></a></div></div></Container></section>

  <section class="section final-cta" aria-labelledby="cta-title"><Container><div class="cta-grid"><div><Eyebrow>START A CONVERSATION</Eyebrow><h2 id="cta-title">Still doing something your system should be doing for you?</h2></div><div class="cta-side"><p>If your business is losing time between disconnected tools, manual workflows, scattered data, or a process that no longer scales, I can help you design a better system.</p><div class="button-row"><Button href="/contact/">Start a Project</Button><Button href="/work/" variant="secondary">View Selected Work</Button></div></div></div></Container></section>
</BaseLayout>

<style>
  .section{border-top:1px solid var(--dark-border)}.section-light{background:var(--light-100);color:var(--text-dark);border-color:var(--light-border)}
  .hero{position:relative;min-height:100svh;display:grid;align-items:center;padding-block:clamp(8.5rem,12vw,11rem) clamp(5rem,8vw,7rem);background:var(--navy-950);overflow:hidden}.hero-media{position:absolute;inset:-8px;z-index:0;overflow:hidden;background:var(--navy-950)}.hero-media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 48%;filter:blur(1.5px) saturate(.9) contrast(.98);transform:scale(1.018)}.hero::before{position:absolute;inset:0;z-index:1;content:'';background:linear-gradient(90deg,rgba(4,16,36,.66) 0%,rgba(5,24,52,.46) 42%,rgba(5,24,52,.11) 72%,rgba(4,16,36,.2) 100%),linear-gradient(180deg,rgba(4,16,36,.06) 0%,rgba(4,16,36,0) 56%,rgba(4,16,36,.38) 100%)}.hero::after{position:absolute;right:5%;top:22%;z-index:1;width:34rem;height:34rem;border-radius:50%;background:color-mix(in srgb,var(--blue) 9%,transparent);filter:blur(120px);content:'';pointer-events:none}.hero :global(.container){position:relative;z-index:2}.hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(320px,5fr);gap:clamp(3rem,7vw,7rem);align-items:center}.hero-copy{min-width:0;padding:clamp(1.3rem,2.5vw,2.1rem);border:1px solid rgba(255,255,255,.2);border-radius:26px;background:linear-gradient(135deg,rgba(6,22,48,.45),rgba(255,255,255,.07));box-shadow:0 24px 70px rgba(2,10,26,.18),inset 0 1px 0 rgba(255,255,255,.12);-webkit-backdrop-filter:blur(16px) saturate(1.2);backdrop-filter:blur(16px) saturate(1.2);text-shadow:0 2px 28px rgba(3,12,28,.2)}.hero h1{max-width:12ch;margin:0;font-size:clamp(4.5rem,6.1vw,5.5rem);font-weight:500;letter-spacing:-.052em;line-height:.95}.hero-lede{max-width:42rem;margin:2rem 0 0;color:var(--text-light-secondary);font-size:clamp(1.05rem,1.4vw,1.25rem)}.button-row{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.credibility{display:flex;align-items:center;gap:.7rem;max-width:39rem;margin:clamp(3rem,7vw,5rem) 0 0;color:var(--text-light-secondary);font-size:1rem}.credibility span{width:6px;height:6px;flex:0 0 auto;border-radius:50%;background:var(--warm-accent)}
  .featured-work{background:var(--navy-900)}.projects-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin-top:clamp(3rem,6vw,5rem)}.project-card{min-width:0;overflow:hidden;border:1px solid var(--dark-border);border-radius:var(--radius-lg);background:var(--navy-800)}.project-card--lead{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1.65fr) minmax(320px,.75fr)}.project-card--lead :global(.project-preview){min-height:480px;border-width:0 1px 0 0;border-radius:0}.project-card:not(.project-card--lead) :global(.project-preview){border-width:0 0 1px;border-radius:0}.project-content{padding:clamp(1.5rem,3vw,2.5rem)}.project-category{margin:0 0 .8rem;color:var(--blue-hover);font-size:.68rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.project-card h3{margin:0;font-size:clamp(1.7rem,3vw,2.4rem);font-weight:500;letter-spacing:-.035em;line-height:1.05}.project-summary{max-width:42rem;margin:1rem 0 0;color:var(--text-light-secondary);font-size:1rem}.tag-list,.capabilities{display:flex;flex-wrap:wrap;gap:.45rem;margin:1.4rem 0 0;padding:0;list-style:none}.tag-list li,.capabilities li{padding:.35rem .6rem;border:1px solid var(--dark-border);border-radius:999px;color:var(--text-light-secondary);font-size:.64rem}.text-link,.section-link{display:inline-flex;min-height:44px;align-items:center;gap:.5rem;margin-top:1.5rem;font-size:.8rem;font-weight:650}.text-link span,.section-link span{transition:transform .2s}.text-link:hover span,.section-link:hover span{transform:translateX(4px)}.section-link{margin-top:2.5rem;color:var(--text-light)}.section-link--dark{color:var(--text-dark)}
  .problem-grid{display:grid;grid-template-columns:minmax(0,8fr) minmax(280px,4fr);gap:clamp(3rem,8vw,8rem);align-items:end}.problem h2{margin:0;font-size:clamp(3.5rem,6vw,6.6rem);font-weight:500;letter-spacing:-.055em;line-height:.9}.problem h2 span{display:block;margin-top:.25em;color:var(--text-dark-secondary)}.problem-copy{padding-bottom:.5rem}.problem-copy p{margin:0;color:var(--text-dark-secondary);font-size:1.05rem}.problem-copy .problem-emphasis{margin-top:2.2rem;color:var(--text-dark);font-size:1.35rem;font-weight:600;line-height:1.35}.problem-copy .problem-close{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--light-border);font-size:.82rem;font-weight:650;text-transform:uppercase;letter-spacing:.08em}
  .services{border-top:1px solid var(--light-border)}.services-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1px;margin-top:clamp(3rem,6vw,5rem);background:var(--light-border);border:1px solid var(--light-border)}.service-panel{min-height:360px;padding:clamp(1.5rem,4vw,3rem);background:var(--light-100)}.service-panel:nth-child(1),.service-panel:nth-child(4){grid-column:span 7}.service-panel:nth-child(2),.service-panel:nth-child(3){grid-column:span 5}.services-grid .service-panel:nth-child(n+3){background:var(--light-200)}.service-top{display:flex;justify-content:space-between;color:var(--text-dark-secondary);font-size:.72rem}.service-mark{width:18px;height:18px;border-top:1px solid var(--text-dark-secondary);border-right:1px solid var(--text-dark-secondary)}.service-panel h3{max-width:14ch;margin:clamp(3rem,6vw,5rem) 0 0;font-size:clamp(1.75rem,2.7vw,2.4rem);font-weight:500;letter-spacing:-.035em;line-height:1.05}.service-panel p{max-width:38rem;margin:1.2rem 0 0;color:var(--text-dark-secondary)}.capabilities li{border-color:var(--light-border);color:var(--text-dark-secondary);background:color-mix(in srgb,var(--light-100) 75%,transparent)}
  .architecture-section{background:var(--navy-950)}.section-intro-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(280px,4fr);gap:clamp(3rem,8vw,8rem);align-items:end;margin-bottom:clamp(3rem,6vw,5rem)}.section-side-copy{max-width:32rem;margin:0;color:var(--text-light-secondary)}.section-side-copy p{margin:0}.section-side-copy p+p{margin-top:1.25rem}.diagram-note{margin:1rem 0 0;color:var(--text-muted);font-size:.7rem}
  .process-list{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin:clamp(3rem,6vw,5rem) 0 0;padding:2rem 0 0;border-top:1px solid var(--light-border);list-style:none}.process-list::before{position:absolute;top:-4px;left:0;width:8px;height:8px;border-radius:50%;background:var(--blue);content:''}.process-list li{min-width:0;padding-right:clamp(1.2rem,3vw,2.5rem)}.process-list li+li{padding-left:clamp(1.2rem,3vw,2.5rem);border-left:1px solid var(--light-border)}.process-number{color:var(--blue);font-size:.7rem}.process-list h3{margin:3rem 0 .8rem;font-size:clamp(1.5rem,2.4vw,2rem);font-weight:500;letter-spacing:-.03em}.process-list p{margin:0;color:var(--text-dark-secondary);font-size:1rem}
  .deep-dive{background:var(--navy-900)}.architecture-label{margin:0 0 1rem;color:var(--blue-hover);font-size:.66rem;font-weight:700;letter-spacing:.12em}.deep-dive-grid{display:grid;grid-template-columns:1fr 1.2fr 1fr;border:1px solid var(--dark-border);border-radius:var(--radius-lg);overflow:hidden}.deep-dive-grid article{min-height:390px;padding:clamp(1.5rem,4vw,3rem);background:var(--navy-900)}.deep-dive-grid article+article{border-left:1px solid var(--dark-border)}.deep-dive-grid .system-column{background:var(--navy-800)}.deep-dive-grid article>span{color:var(--text-muted);font-size:.65rem;letter-spacing:.13em}.deep-dive-grid h3{margin:2.5rem 0 0;font-size:1.4rem;font-weight:500}.deep-dive-grid ul{display:grid;gap:.75rem;margin:2.5rem 0 0;padding:0;list-style:none;color:var(--text-light-secondary);font-size:1rem}.deep-dive-grid li{padding-bottom:.75rem;border-bottom:1px solid var(--dark-border)}.flow{display:grid;justify-items:center;gap:.65rem;margin-top:2rem}.flow b{width:100%;padding:.75rem;border:1px solid var(--dark-border);border-radius:8px;color:var(--text-light-secondary);text-align:center;font-size:.75rem;font-weight:500}.flow i{color:var(--blue);font-style:normal}
  .proof .section-intro-grid{align-items:start}.proof-note{max-width:15rem;margin:2rem 0 0;padding-left:1rem;border-left:2px solid var(--blue);color:var(--text-dark-secondary);font-size:.8rem}.proof-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(210px,auto);gap:1px;background:var(--light-border);border:1px solid var(--light-border)}.proof-item{position:relative;overflow:hidden;padding:1.5rem;background:var(--light-100)}.proof-item--wide{grid-column:span 2}.proof-item:last-child{grid-column:span 3}.proof-item>span{color:var(--text-dark-secondary);font-size:.65rem}.proof-item>strong{display:block;max-width:16ch;margin-top:.8rem;font-size:1.15rem;font-weight:500}.proof-item>p{color:var(--text-dark-secondary);font-size:.75rem}.walkthrough-lines,.mini-grid,.map-dots,.mini-bars{position:absolute;inset:auto 1.5rem 1.5rem;display:grid;gap:7px}.walkthrough-lines i{height:9px;background:var(--light-border)}.walkthrough-lines i:nth-child(2){width:72%}.walkthrough-lines i:nth-child(3){width:42%;background:var(--blue)}.mini-grid{grid-template-columns:repeat(2,1fr)}.mini-grid i{height:32px;border:1px solid var(--light-border)}.map-dots{grid-template-columns:repeat(3,1fr);align-items:center}.map-dots i{position:relative;width:14px;height:14px;border:2px solid var(--text-dark-secondary);border-radius:50%}.map-dots i:not(:last-child)::after{position:absolute;left:12px;top:5px;width:70px;height:1px;background:var(--light-border);content:''}.mini-bars{grid-template-columns:repeat(4,1fr);align-items:end}.mini-bars i{height:30px;background:var(--light-border)}.mini-bars i:nth-child(2){height:55px}.mini-bars i:nth-child(3){height:42px;background:var(--blue)}.mini-bars i:nth-child(4){height:70px;background:var(--warm-accent)}
  .about{background:var(--navy-950)}.about-grid{display:grid;grid-template-columns:5fr 7fr;gap:clamp(3rem,8vw,8rem);align-items:center}.identity-visual{position:relative;min-height:560px;padding:2rem;border:1px solid var(--dark-border);border-radius:var(--radius-lg);background:linear-gradient(145deg,var(--navy-800),var(--navy-900));overflow:hidden}.identity-visual::before{position:absolute;inset:0;content:'';background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:36px 36px}.identity-wordmark{position:relative;z-index:1;display:block;margin-top:35%;font-size:clamp(5rem,10vw,9rem);font-weight:600;letter-spacing:-.08em;line-height:1}.identity-wordmark span{color:var(--blue)}.identity-lines{position:absolute;inset:2rem;display:grid;align-content:end;gap:8px}.identity-lines i{height:1px;background:var(--dark-border)}.identity-lines i:nth-child(2){width:80%}.identity-lines i:nth-child(3){width:55%;background:var(--blue)}.identity-lines i:nth-child(4){width:35%;background:var(--warm-accent)}.identity-visual p{position:absolute;left:2rem;bottom:2rem;margin:0;color:var(--text-muted);font-size:.65rem;letter-spacing:.11em;text-transform:uppercase}.about-copy h2,.final-cta h2{margin:0;font-size:clamp(3.2rem,5.5vw,5.4rem);font-weight:500;letter-spacing:-.05em;line-height:.94}.about-copy>p{max-width:40rem;margin:1.35rem 0 0;color:var(--text-light-secondary)}
  .article-list{margin-top:clamp(3rem,6vw,5rem);border-top:1px solid var(--light-border)}.article-list>a{display:grid;grid-template-columns:60px minmax(0,1fr) 40px;gap:1.5rem;align-items:center;min-height:150px;border-bottom:1px solid var(--light-border);transition:padding .2s}.article-list>a:hover{padding-inline:1rem}.article-number{color:var(--blue);font-size:.7rem}.article-list p{margin:0 0 .5rem;color:var(--text-dark-secondary);font-size:.68rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase}.article-list h3{max-width:30ch;margin:0;font-size:clamp(1.35rem,2.4vw,2rem);font-weight:500;letter-spacing:-.03em;line-height:1.1}.article-arrow{justify-self:end;color:var(--blue);font-size:1.2rem}
  .final-cta{position:relative;padding-block:clamp(6rem,11vw,10rem);background:linear-gradient(145deg,#f8fafc 0%,#edf2f8 100%);color:var(--text-dark);overflow:hidden}.final-cta::before{position:absolute;left:-10rem;top:-12rem;width:30rem;height:30rem;border-radius:50%;background:rgba(244,181,64,.18);filter:blur(90px);content:''}.final-cta::after{position:absolute;right:-10rem;bottom:-14rem;width:36rem;height:36rem;border-radius:50%;background:rgba(22,76,155,.11);filter:blur(110px);content:''}.cta-grid{position:relative;z-index:1;display:grid;grid-template-columns:7fr 5fr;gap:clamp(3rem,8vw,8rem);align-items:end;padding:clamp(2rem,5vw,4.5rem);border:1px solid rgba(10,31,61,.12);border-radius:clamp(24px,3vw,36px);background:rgba(255,255,255,.66);box-shadow:0 28px 80px rgba(13,37,70,.1),inset 0 1px 0 rgba(255,255,255,.9);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}.cta-side p{max-width:33rem;margin:0;color:var(--text-dark-secondary)}
  @media(max-width:1023px){.hero-grid{grid-template-columns:minmax(0,1fr) minmax(220px,.55fr);gap:3rem}.hero h1{font-size:clamp(3.5rem,7vw,4.8rem)}.project-card--lead{grid-template-columns:1.25fr .75fr}.problem-grid,.section-intro-grid{grid-template-columns:7fr 5fr}.proof-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.proof-item:last-child{grid-column:span 1}.process-list{grid-template-columns:repeat(2,minmax(0,1fr))}.process-list li:nth-child(3){border-left:0}.cta-grid{grid-template-columns:1fr 1fr}.technology ul{justify-content:flex-start;flex-wrap:wrap}}
  @media(max-width:767px){.section{padding-block:clamp(4.5rem,20vw,6rem)}.hero{min-height:auto;padding-block:7.5rem 5rem}.hero-media img{object-position:83% center;filter:blur(.75px) saturate(.94) contrast(1);transform:scale(1.015)}.hero::before{background:linear-gradient(90deg,rgba(4,18,40,.4),rgba(4,18,40,.16)),linear-gradient(180deg,rgba(4,18,40,.02),rgba(4,18,40,.3))}.hero-grid{grid-template-columns:minmax(0,1fr);gap:3rem}.hero-copy{padding:1.2rem;border-color:rgba(255,255,255,.24);border-radius:22px;background:linear-gradient(135deg,rgba(5,20,44,.3),rgba(255,255,255,.06));box-shadow:0 20px 55px rgba(2,10,26,.13),inset 0 1px 0 rgba(255,255,255,.14);-webkit-backdrop-filter:blur(5px) saturate(1.08);backdrop-filter:blur(5px) saturate(1.08)}.hero h1{max-width:none;font-size:clamp(2.625rem,11vw,3.25rem);text-shadow:0 2px 22px rgba(2,10,24,.6)}.hero-lede{font-size:1rem;text-shadow:0 2px 16px rgba(2,10,24,.65)}.button-row{display:grid;grid-template-columns:minmax(0,1fr)}.button-row>:global(a){width:100%;min-width:0}.credibility{margin-top:3rem}.technology-inner{grid-template-columns:minmax(0,1fr);gap:.75rem}.technology ul{justify-content:flex-start;flex-wrap:wrap;gap:.35rem .55rem}.technology li{font-size:.75rem}.technology li:not(:last-child)::after{margin-left:.55rem}.projects-grid{grid-template-columns:minmax(0,1fr)}.project-card--lead{grid-column:auto;display:block}.project-card--lead :global(.project-preview){min-height:240px;border-width:0 0 1px}.project-card h3{font-size:clamp(1.4rem,7vw,1.75rem)}.problem-grid,.section-intro-grid,.about-grid,.cta-grid{grid-template-columns:minmax(0,1fr);gap:2.5rem}.problem h2{font-size:clamp(2.6rem,12vw,4rem)}.problem-copy p{font-size:1rem}.services-grid{grid-template-columns:minmax(0,1fr)}.service-panel:nth-child(n){grid-column:auto}.service-panel{min-height:auto}.service-panel h3{margin-top:3rem;font-size:clamp(1.4rem,7vw,1.8rem)}.process-list{grid-template-columns:minmax(0,1fr);padding-top:0;border-top:0}.process-list::before